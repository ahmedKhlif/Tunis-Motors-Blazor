@using BlazorApp.Services
@using BlazorApp.Models
@inject ICategoryService CategoryService
@inject NavigationManager NavigationManager

<div class="card border-0 shadow-lg">
    <div class="card-header bg-dark text-white">
        <h6 class="mb-0"><i class="fa fa-tags me-2"></i>Categories</h6>
    </div>
    <div class="card-body p-0">
        @if (categories == null || !categories.Any())
        {
            <div class="p-3 text-muted small">
                <i class="fa fa-info-circle me-2"></i>No categories available.
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var category in categories)
                {
                    <a class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0"
                       href="/shop?categoryId=@category.CategoryId"
                       @onclick="() => NavigateToCategory(category.CategoryId)">
                        <i class="fa fa-car me-3 text-primary"></i>
                        <span class="fw-medium">@category.CategoryName</span>
                        <i class="fa fa-chevron-right ms-auto text-muted"></i>
                    </a>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<CategoryDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAllCategoriesAsync() ?? new List<CategoryDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading categories: {ex.Message}");
        }
    }

    private void NavigateToCategory(int categoryId)
    {
        NavigationManager.NavigateTo($"/shop?categoryId={categoryId}");
    }
}