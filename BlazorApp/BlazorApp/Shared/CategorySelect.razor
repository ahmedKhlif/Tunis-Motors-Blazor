@using BlazorApp.Services
@using BlazorApp.Models
@inject ICategoryService CategoryService

@if (Categories != null && Categories.Any())
{
    <option value="@DefaultValue">@DefaultText</option>
    @foreach (var category in Categories)
    {
        <option value="@category.CategoryId.ToString()">@category.CategoryName</option>
    }
}
else
{
    <option value="@DefaultValue">@DefaultText</option>
}

@code {
    [Parameter]
    public List<CategoryDto> Categories { get; set; } = new();

    [Parameter]
    public string DefaultText { get; set; } = "All Categories";

    [Parameter]
    public string DefaultValue { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (Categories == null || !Categories.Any())
        {
            try
            {
                Categories = await CategoryService.GetAllCategoriesAsync() ?? new List<CategoryDto>();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading categories: {ex.Message}");
                Categories = new List<CategoryDto>();
            }
        }
    }
}