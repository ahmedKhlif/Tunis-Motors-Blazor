        <div class="container">
            <div class="row align-items-center py-2">
                <div class="col-md-8">
                    <ul class="header-links list-unstyled d-flex flex-wrap mb-0">
                        <li class="me-4"><a href="tel:+216955184"><i class="fa fa-phone me-1"></i> +216 95 518 4</a></li>
                        <li class="me-4"><a href="mailto:contact@carecommerce.tn"><i class="fa fa-envelope me-1"></i> contact@carecommerce.tn</a></li>
                        <li><a href="#"><i class="fa fa-map-marker-alt me-1"></i> Tunis, Tunisia</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-md-end">
                    <ul class="header-links list-unstyled d-flex justify-content-end mb-0">
                        <li class="me-3"><a href="#"><i class="fa fa-tunisian-dinar me-1"></i> TND</a></li>
                        <AuthorizeView Context="auth">
                            <Authorized>
                                <li><a href="/profile"><i class="fa fa-user me-1"></i> My Account</a></li>
                            </Authorized>
                            <NotAuthorized>
                                <li><a href="/login"><i class="fa fa-user me-1"></i> Login</a></li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER -->
    <header id="header" class="py-3">
        <div class="container">
            <div class="row align-items-center">
                <!-- Logo -->
                <div class="col-md-3 col-6">
                    <a href="/" class="logo">
                        <img src="images/logo.png" alt="Tunisia Motors" class="img-fluid" style="height: 60px;">
                    </a>
                </div>

                <!-- Search -->
                <div class="col-md-6 col-12 mt-3 mt-md-0">
                    <form method="get" action="/shop" class="d-flex">
                        <select class="form-select me-2" name="categoryId" style="min-width: 150px;">
                            <option value="">All Categories</option>
                            @if (categories != null && categories.Any())
                            {
                                foreach (var category in categories)
                                {
                                    <option value="@category.CategoryId">@category.CategoryName</option>
                                }
                            }
                        </select>
                        <input class="form-control me-2" name="searchTerm" placeholder="Search cars..." />
                        <button class="btn btn-primary" type="submit">
                            <i class="fa fa-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Header Actions -->
                <div class="col-md-3 col-6 text-end">
                    <div class="d-flex justify-content-end align-items-center gap-3">
                        <AuthorizeView Context="auth">
                            <Authorized>
                                <a href="/messages" class="position-relative text-decoration-none" title="Messages">
                                    <i class="fa fa-envelope fa-lg"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="unread-count" style="font-size: 0.7em; display: none;">0</span>
                                </a>
                            </Authorized>
                        </AuthorizeView>
                        <a href="/cart" class="position-relative text-decoration-none" title="Shopping Cart">
                            <i class="fa fa-shopping-cart fa-lg"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" id="cart-count" style="font-size: 0.7em;">0</span>
                        </a>
                        <a href="/compare" class="position-relative text-decoration-none" title="Compare Cars">
                            <i class="fa fa-exchange fa-lg"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info" id="compare-count" style="font-size: 0.7em;">0</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

