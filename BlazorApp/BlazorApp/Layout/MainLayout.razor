                                    <li><a class="dropdown-item" href="/admin"><i class="fa fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" href="/admin/approvals"><i class="fa fa-clipboard-check me-2"></i>Pending Approvals</a></li>
                                    <li><hr class="dropdown-divider"></li>
