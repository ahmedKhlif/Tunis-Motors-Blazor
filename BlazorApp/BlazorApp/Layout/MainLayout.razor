@code {
    [Inject]
    private IAuthService AuthService { get; set; }

    [Inject]
    private NavigationManager NavManager { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    private string PageTitle { get; set; } = "Tunisia Motors";
    private string CurrentUserName { get; set; } = "User";
    private UserDto CurrentUser { get; set; }
    private List<CategoryDto> categories = new();
    private System.Threading.Timer _updateTimer;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to authentication state changes
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        // Subscribe to compare service changes
        CompareService.OnCompareChanged += OnCompareChanged;

        await LoadUserData();
        await LoadCategories();

        // Debug: Check authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        Console.WriteLine($"[MainLayout] User authenticated: {user.Identity?.IsAuthenticated}");
        Console.WriteLine($"[MainLayout] User name: {user.Identity?.Name}");
        Console.WriteLine($"[MainLayout] User claims: {string.Join(", ", user.Claims.Select(c => $"{c.Type}: {c.Value}"))}");
        Console.WriteLine($"[MainLayout] User roles: {string.Join(", ", user.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))}");

        // Start periodic updates
        _updateTimer = new System.Threading.Timer(async _ => await UpdateBadges(), null, TimeSpan.Zero, TimeSpan.FromSeconds(10));
    }

    private async void OnCompareChanged()
    {
        await UpdateBadges();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            Console.WriteLine("[MainLayout] Authentication state changed!");
            var authState = await task;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                Console.WriteLine("[MainLayout] User is authenticated, reloading user data...");
                await LoadUserData();
                await UpdateBadges();
            }
            else
            {
                Console.WriteLine("[MainLayout] User is not authenticated");
                CurrentUserName = "User";
                CurrentUser = null;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error in OnAuthenticationStateChanged: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUserData();
            await UpdateBadges();
            StateHasChanged();
        }
    }

    private async Task UpdateBadges()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // Update cart count
                var cartResponse = await CartService.GetCartCountAsync();
                if (cartResponse.Success)
                {
                    await JSRuntime.InvokeVoidAsync("updateCartBadge", cartResponse.Data);
                    // Also update localStorage for backward compatibility
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "cart_count", cartResponse.Data.ToString());
                }

                // Update unread message count
                var unreadCount = await MessageService.GetUnreadCountAsync();
                await JSRuntime.InvokeVoidAsync("updateMessageBadge", unreadCount);

                // Update compare count
                var compareCount = await CompareService.GetCompareCountAsync();
                await JSRuntime.InvokeVoidAsync("updateCompareBadge", compareCount);
            }
            else
            {
                // Update compare count even for non-authenticated users (compare uses localStorage)
                var compareCount = await CompareService.GetCompareCountAsync();
                await JSRuntime.InvokeVoidAsync("updateCompareBadge", compareCount);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error updating badges: {ex.Message}");
        }
    }

    private async Task LoadUserData()
    {
        try
        {
            Console.WriteLine("[MainLayout] Loading user data...");
            CurrentUser = await AuthService.GetCurrentUserAsync();

            if (CurrentUser != null)
            {
                Console.WriteLine($"[MainLayout] User loaded: {CurrentUser.Email}");
                CurrentUserName = CurrentUser.Email ?? CurrentUser.UserName ?? "User";
            }
            else
            {
                Console.WriteLine("[MainLayout] No user data returned");
                CurrentUserName = "User";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error loading user data: {ex.Message}");
            CurrentUserName = "User";
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAllCategoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Error loading categories: {ex.Message}");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        _updateTimer?.Dispose();
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        CompareService.OnCompareChanged -= OnCompareChanged;
    }
}
