                        <li><a href="/shop?brand=BMW" class="text-white-50"><i class="fas fa-car me-2"></i>BMW</a></li>
                        <li><a href="/shop?brand=Mercedes" class="text-white-50"><i class="fas fa-car me-2"></i>Mercedes</a></li>
                        <li><a href="/shop?brand=Audi" class="text-white-50"><i class="fas fa-car me-2"></i>Audi</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="footer-title">Information</h5>
