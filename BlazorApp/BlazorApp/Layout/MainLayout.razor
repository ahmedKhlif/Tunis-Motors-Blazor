                            <li class="nav-item">
                                <a class="nav-link @(Navigation.Uri.Contains("/create-listing") ? "active" : "")" href="/create-listing">
                                    <i class="fa fa-plus-circle me-1"></i> Add Car
                                </a>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop?searchTerm=new">
                            <i class="fa fa-car-battery me-1"></i> New Cars
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop?searchTerm=used">
                            <i class="fa fa-car-crash me-1"></i> Used Cars
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop?brand=BMW">
                            <i class="fab fa-bmw me-1"></i> BMW
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop?brand=Mercedes">
                            <i class="fab fa-mercedes me-1"></i> Mercedes
