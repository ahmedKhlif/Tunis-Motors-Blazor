                                    @if (auth.User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" href="/admin/users"><i class="fa fa-user-cog me-2"></i>Manage Users</a></li>
                                        <li><a class="dropdown-item" href="/admin/list-roles"><i class="fa fa-users me-2"></i>Manage Roles</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/admin/orders"><i class="fa fa-shopping-bag me-2"></i>Manage Orders</a></li>
                                    <li><a class="dropdown-item" href="/admin/rentals"><i class="fa fa-calendar me-2"></i>Rental Management</a></li>
                                    <li><a class="dropdown-item" href="/admin/analytics"><i class="fa fa-bar-chart me-2"></i>Analytics</a></li>
                                </ul>
                            </li>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="Seller,Admin,Manager" Context="auth">
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa fa-car me-1"></i> My Cars
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/seller-dashboard"><i class="fa fa-chart-line me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" href="/create-listing"><i class="fa fa-plus me-2"></i>Add New Car</a></li>
                                    <li><a class="dropdown-item" href="/my-listings"><i class="fa fa-list me-2"></i>My Listings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/seller/rental-management"><i class="fa fa-calendar me-2"></i>Rental Management</a></li>
                                </ul>
                            </li>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Context="auth">
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa fa-user me-1"></i> @CurrentUserName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/buyer-dashboard"><i class="fa fa-chart-line me-2"></i>My Dashboard</a></li>
                                    <li><a class="dropdown-item" href="/profile"><i class="fa fa-user-edit me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" href="/my-orders"><i class="fa fa-shopping-bag me-2"></i>My Orders</a></li>
                                    <li><a class="dropdown-item" href="/my-rentals"><i class="fa fa-calendar me-2"></i>My Rentals</a></li>
                                    <li><a class="dropdown-item" href="/messages"><i class="fa fa-envelope me-2"></i>Messages</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/cart"><i class="fa fa-shopping-cart me-2"></i>My Cart</a></li>
                                    <li><a class="dropdown-item" href="/wishlist"><i class="fa-regular fa-heart me-2"></i>My Wishlist</a></li>
                                    <li><a class="dropdown-item" href="/compare"><i class="fa fa-exchange me-2"></i>Compare Cars</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
