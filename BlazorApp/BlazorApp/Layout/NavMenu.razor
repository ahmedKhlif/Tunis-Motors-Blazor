        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="admin/orders">
                <i class="fa fa-shopping-bag"></i> Order Management
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="admin/rentals">
                <i class="fa fa-calendar"></i> Rental Management
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private int unreadCount = 0;
    private Timer? updateTimer;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        await UpdateUnreadCount();
        
        // Update unread count every 30 seconds
        updateTimer = new Timer(30000);
        updateTimer.Elapsed += async (sender, e) => await UpdateUnreadCount();
        updateTimer.Start();
    }

    private async Task UpdateUnreadCount()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                unreadCount = await MessageService.GetUnreadCountAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating unread count: {ex.Message}");
            unreadCount = 0;
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        updateTimer?.Stop();
        updateTimer?.Dispose();
    }
}
