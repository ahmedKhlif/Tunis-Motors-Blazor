        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="admin/approvals">
                <i class="fa fa-check-circle"></i> Approvals
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="admin/categories">
                <i class="fa fa-tags"></i> Categories
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="admin/users">
                <i class="fa fa-users"></i> Users
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="admin/list-roles">
