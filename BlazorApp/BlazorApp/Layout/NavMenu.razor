            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="cart">
                <i class="fa fa-shopping-cart"></i> My Cart
            </NavLink>
        </div>

        <!-- Rentals -->
        <div class="nav-divider my-2"></div>
        <div class="nav-item px-3">
            <span class="nav-link" style="cursor: default;">
                <i class="fa fa-calendar"></i> Rentals
            </span>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="rentals">
                <i class="fa fa-car"></i> Rent a Car
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="my-rentals">
                <i class="fa fa-history"></i> My Rentals
            </NavLink>
        </div>

        <!-- Seller Tools -->
        <div class="nav-divider my-2"></div>
        <div class="nav-item px-3">
            <span class="nav-link" style="cursor: default;">
                <i class="fa fa-plus-circle"></i> Seller
            </span>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="create-listing">
                <i class="fa fa-plus"></i> Create Listing
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="my-listings">
                <i class="fa fa-list"></i> My Listings
            </NavLink>
        </div>

        <!-- User Account -->
        <div class="nav-divider my-2"></div>
        <div class="nav-item px-3">
            <span class="nav-link" style="cursor: default;">
                <i class="fa fa-user"></i> Account
            </span>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="profile">
                <i class="fa fa-user-circle"></i> My Profile
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="my-orders">
                <i class="fa fa-history"></i> My Orders
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="wishlist">
                <i class="fa fa-heart"></i> Wishlist
            </NavLink>
        </div>
        <div class="nav-item px-3 ps-4">
            <NavLink class="nav-link" href="messages">
                <i class="fa fa-envelope"></i> Messages
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger ms-2">@unreadCount</span>
