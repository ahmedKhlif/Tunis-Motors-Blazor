@page "/rentals"
@using BlazorApp.Services
@using BlazorApp.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ICarListingService CarListingService
@inject NavigationManager NavManager
@inject IConfiguration Configuration

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Rent a Car</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li class="active">Rent a Car</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">

    <!-- Header -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="text-center">
                <h1 class="display-4 fw-bold text-primary mb-3">Rent a Car</h1>
                <p class="lead text-muted">Choose from our wide selection of rental vehicles</p>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="searchTerm" class="form-label fw-bold">Search</label>
                            <input type="text" id="searchTerm" class="form-control" placeholder="Search cars..."
                                   @bind="filter.SearchTerm" @bind:after="ApplyFilters">
                        </div>
                        <div class="col-md-2">
                            <label for="brand" class="form-label fw-bold">Brand</label>
                            <select id="brand" class="form-select" @bind="filter.Brand" @bind:after="ApplyFilters">
                                <option value="">All Brands</option>
                                @if (brands != null)
                                {
                                    @foreach (var brand in brands)
                                    {
                                        <option value="@brand">@brand</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="fuelType" class="form-label fw-bold">Fuel Type</label>
                            <select id="fuelType" class="form-select" @bind="filter.FuelType" @bind:after="ApplyFilters">
                                <option value="">All Types</option>
                                @if (fuelTypes != null)
                                {
                                    @foreach (var fuel in fuelTypes)
                                    {
                                        <option value="@fuel">@fuel</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="transmission" class="form-label fw-bold">Transmission</label>
                            <select id="transmission" class="form-select" @bind="filter.Transmission" @bind:after="ApplyFilters">
                                <option value="">All Types</option>
                                @if (transmissions != null)
                                {
                                    @foreach (var trans in transmissions)
                                    {
                                        <option value="@trans">@trans</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary flex-fill" @onclick="ApplyFilters">
                                    <i class="fa fa-search me-2"></i>Search
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                                    <i class="fa fa-times me-2"></i>Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Finding available rental cars...</p>
        </div>
    }
    else if (cars != null && cars.Data.Any())
    {
        <div class="row">
            @foreach (var car in cars.Data.Where(c => c.IsAvailableForRental && c.RentalStock > 0))
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-lg hover-shadow">
                        <div class="position-relative">
                            <img src="@GetImageUrl(car.Image)" class="card-img-top" alt="@car.Name"
                                 style="height: 200px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-info text-white px-3 py-2">
                                    <i class="fa fa-calendar me-1"></i>RENTAL
                                </span>
                            </div>
                            @if (car.Condition == "New")
                            {
                                <div class="position-absolute top-0 start-0 m-2">
                                    <span class="badge bg-success px-3 py-2">NEW</span>
                                </div>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@car.Name (@car.Year)</h5>
                            <p class="card-text text-muted mb-2">@car.Brand • @car.FuelType • @car.Transmission</p>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= car.Rating)
                                        {
                                            <i class="fa fa-star text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-star-o text-warning"></i>
                                        }
                                    }
                                    <small class="text-muted ms-2">(@car.Rating.ToString("F1"))</small>
                                </div>
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="border-end">
                                            <div class="h6 mb-0 text-primary">@car.Mileage.ToString("N0") km</div>
                                            <small class="text-muted">Mileage</small>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="h6 mb-0 text-primary">@car.DailyRentalRate?.ToString("N0") TND</div>
                                        <small class="text-muted">Per Day</small>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary flex-fill" @onclick="() => RentCar(car.ProductId)">
                                        <i class="fa fa-calendar me-2"></i>Rent Now
                                    </button>
                                    <button class="btn btn-outline-primary" @onclick="() => ViewDetails(car.ProductId)">
                                        <i class="fa fa-eye me-2"></i>Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (cars.TotalPages > 1)
        {
            <nav aria-label="Rental cars pagination" class="mt-5">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= cars.TotalPages; i++)
                    {
                        <li class="page-item @(i == cars.PageNumber ? "active" : "")">
                            <a class="page-link" href="#" @onclick="() => GoToPage(i)">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fa fa-car fa-4x text-muted mb-4"></i>
            <h3 class="text-muted mb-3">No Rental Cars Available</h3>
            <p class="text-muted mb-4">Try adjusting your search criteria or check back later.</p>
            <button class="btn btn-primary" @onclick="ClearFilters">
                <i class="fa fa-refresh me-2"></i>Show All Cars
            </button>
        </div>
    }
    </div>
</div>

<style>
.hover-shadow:hover {
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.175) !important;
    transform: translateY(-2px);
    transition: all 0.3s ease;
}
</style>

@code {
    private PaginatedDto<CarListingDto> cars;
    private List<string> brands;
    private List<string> fuelTypes;
    private List<string> transmissions;
    private CarListingFilterDto filter = new() { PageSize = 12 };
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadFilters();
        await ApplyFilters();
    }

    private async Task LoadFilters()
    {
        try
        {
            brands = await CarListingService.GetBrandsAsync();
            fuelTypes = await CarListingService.GetFuelTypesAsync();
            transmissions = await CarListingService.GetTransmissionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading filters: {ex.Message}");
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            cars = await CarListingService.GetAllListingsAsync(filter);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cars: {ex.Message}");
            cars = new PaginatedDto<CarListingDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilters()
    {
        filter = new CarListingFilterDto { PageSize = 12 };
        await ApplyFilters();
    }

    private async Task GoToPage(int page)
    {
        filter.Page = page;
        await ApplyFilters();
    }

    private void RentCar(int carId)
    {
        NavManager.NavigateTo($"/rent-car/{carId}");
    }

    private void ViewDetails(int carId)
    {
        NavManager.NavigateTo($"/product/{carId}");
    }

    private string GetImageUrl(string? imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
            return "/images/noimage.jpg";

        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
            return imagePath;

        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5237";
        if (imagePath.StartsWith("/"))
            return $"{apiBaseUrl}{imagePath}";

        return $"{apiBaseUrl}/images/{imagePath}";
    }
}