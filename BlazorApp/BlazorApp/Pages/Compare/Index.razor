@page "/compare"
@using BlazorApp.Services
@using BlazorApp.Models
@using BlazorApp.Components
@implements IDisposable
@inject ICompareService CompareService
@inject ICarListingService CarListingService
@inject NavigationManager NavManager
@inject IConfiguration Configuration

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Compare Cars</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li class="active">Compare Cars</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading comparison...</p>
            </div>
        }
        else if (comparedCars == null || !comparedCars.Any())
        {
            <div class="text-center py-5">
                <i class="fa fa-exchange fa-4x text-muted mb-3"></i>
                <h3 class="text-muted">No Cars to Compare</h3>
                <p class="text-muted mb-4">Add cars to compare from the product listings or details pages.</p>
                <a href="/shop" class="btn btn-primary">
                    <i class="fa fa-arrow-left me-2"></i>Browse Cars
                </a>
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="section-title">Compare Cars</h2>
                        <button class="btn btn-outline-danger" @onclick="ClearCompare">
                            <i class="fa fa-trash me-2"></i>Clear All
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 200px;">Specification</th>
                            @foreach (var car in comparedCars)
                            {
                                <th class="text-center" style="min-width: 250px;">
                                    <div class="position-relative">
                                        <button class="btn btn-sm btn-outline-danger position-absolute top-0 end-0" 
                                                style="z-index: 10;"
                                                @onclick="() => RemoveCar(car.Id)"
                                                title="Remove from compare">
                                            <i class="fa fa-times"></i>
                                        </button>
                                        <img src="@GetImageUrl(car.Image)" 
                                             class="img-fluid rounded mb-2" 
                                             alt="@car.Name"
                                             style="max-height: 150px; width: 100%; object-fit: cover;">
                                        <h5 class="mb-1">@car.Name</h5>
                                        <p class="text-muted small mb-2">@car.Brand • @car.Year</p>
                                        <div class="mb-2">
                                            <strong class="text-primary h5">@car.Price.ToString("N0") TND</strong>
                                        </div>
                                        @if (car.IsAvailableForRental && car.DailyRentalRate.HasValue)
                                        {
                                            <div class="mb-2">
                                                <small class="text-muted">Rental:</small>
                                                <strong class="text-success">@car.DailyRentalRate.Value.ToString("N0") TND/day</strong>
                                            </div>
                                        }
                                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                                            <a href="/product/@car.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-eye"></i> View
                                            </a>
                                            @if (car.QuantityInStock > 0)
                                            {
                                                <a href="/product/@car.Id" class="btn btn-sm btn-success">
                                                    <i class="fa fa-shopping-cart"></i> Buy
                                                </a>
                                            }
                                            @if (car.IsAvailableForRental && car.RentalStock > 0)
                                            {
                                                <a href="/rent-car/@car.Id" class="btn btn-sm btn-info">
                                                    <i class="fa fa-calendar"></i> Rent
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Price</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">
                                    <strong class="text-primary">@car.Price.ToString("N0") TND</strong>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Daily Rental Rate</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">
                                    @if (car.IsAvailableForRental && car.DailyRentalRate.HasValue)
                                    {
                                        <strong class="text-success">@car.DailyRentalRate.Value.ToString("N0") TND/day</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not available</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Brand</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@car.Brand</td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Year</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@car.Year</td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Mileage</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@car.Mileage.ToString("N0") km</td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Fuel Type</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@car.FuelType</td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Transmission</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@car.Transmission</td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Color</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@car.Color</td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Condition</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">
                                    <span class="badge bg-@(car.Condition == "New" ? "success" : "info")">
                                        @car.Condition
                                    </span>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Rating</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= car.Rating)
                                        {
                                            <i class="fa fa-star text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-star-o text-warning"></i>
                                        }
                                    }
                                    <span class="ms-1">(@car.Rating)</span>
                                </td>
                            }
                        </tr>
                        @if (comparedCars.Any(c => c.EngineSize.HasValue))
                        {
                            <tr>
                                <td><strong>Engine Size</strong></td>
                                @foreach (var car in comparedCars)
                                {
                                    <td class="text-center">
                                        @(car.EngineSize?.ToString("F1") ?? "N/A") L
                                    </td>
                                }
                            </tr>
                        }
                        @if (comparedCars.Any(c => c.Horsepower.HasValue))
                        {
                            <tr>
                                <td><strong>Horsepower</strong></td>
                                @foreach (var car in comparedCars)
                                {
                                    <td class="text-center">
                                        @(car.Horsepower?.ToString() ?? "N/A") HP
                                    </td>
                                }
                            </tr>
                        }
                        @if (comparedCars.Any(c => c.Doors.HasValue))
                        {
                            <tr>
                                <td><strong>Doors</strong></td>
                                @foreach (var car in comparedCars)
                                {
                                    <td class="text-center">@(car.Doors?.ToString() ?? "N/A")</td>
                                }
                            </tr>
                        }
                        @if (comparedCars.Any(c => c.Seats.HasValue))
                        {
                            <tr>
                                <td><strong>Seats</strong></td>
                                @foreach (var car in comparedCars)
                                {
                                    <td class="text-center">@(car.Seats?.ToString() ?? "N/A")</td>
                                }
                            </tr>
                        }
                        <tr>
                            <td><strong>Stock (Sale)</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">
                                    @if (car.QuantityInStock > 0)
                                    {
                                        <span class="badge bg-success">@car.QuantityInStock available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Stock (Rental)</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">
                                    @if (car.IsAvailableForRental && car.RentalStock > 0)
                                    {
                                        <span class="badge bg-info">@car.RentalStock available</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not available</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr>
                            <td><strong>Location</strong></td>
                            @foreach (var car in comparedCars)
                            {
                                <td class="text-center">@(car.Location ?? "N/A")</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<!-- /SECTION -->

@code {
    private List<CarListingDto> comparedCars = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadComparedCars();
        CompareService.OnCompareChanged += OnCompareChanged;
    }

    private async void OnCompareChanged()
    {
        await LoadComparedCars();
        StateHasChanged();
    }

    private async Task LoadComparedCars()
    {
        try
        {
            isLoading = true;
            comparedCars = await CompareService.GetComparedCarsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading compared cars: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RemoveCar(int carId)
    {
        await CompareService.RemoveFromCompareAsync(carId);
        await LoadComparedCars();
    }

    private async Task ClearCompare()
    {
        await CompareService.ClearCompareAsync();
        await LoadComparedCars();
    }

    private string GetImageUrl(string? imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
            return "/images/noimage.jpg";

        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
            return imagePath;

        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5237";
        if (imagePath.StartsWith("/"))
            return $"{apiBaseUrl}{imagePath}";

        return $"{apiBaseUrl}/images/{imagePath}";
    }

    public void Dispose()
    {
        CompareService.OnCompareChanged -= OnCompareChanged;
    }
}

