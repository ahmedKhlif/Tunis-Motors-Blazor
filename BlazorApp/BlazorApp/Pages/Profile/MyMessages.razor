@page "/my-messages"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize]
@inject IMessageService MessageService
@inject NavigationManager NavigationManager

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fa fa-envelope me-2"></i>My Messages</h2>
                <a href="/compose-message" class="btn btn-primary">
                    <i class="fa fa-plus me-2"></i>Compose Message
                </a>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading messages...</p>
                </div>
            }
            else if (messages != null && messages.Any())
            {
                <!-- Tabs for Inbox/Sent -->
                <ul class="nav nav-tabs mb-4" id="messageTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="inbox-tab" data-bs-toggle="tab" data-bs-target="#inbox" type="button" role="tab" aria-controls="inbox" aria-selected="true">
                            <i class="fa fa-inbox me-2"></i>Inbox (@inboxMessages.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="sent-tab" data-bs-toggle="tab" data-bs-target="#sent" type="button" role="tab" aria-controls="sent" aria-selected="false">
                            <i class="fa fa-paper-plane me-2"></i>Sent (@sentMessages.Count)
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="messageTabsContent">
                    <!-- Inbox Tab -->
                    <div class="tab-pane fade show active" id="inbox" role="tabpanel" aria-labelledby="inbox-tab">
                        @if (inboxMessages.Any())
                        {
                            <div class="card shadow">
                                <div class="list-group list-group-flush">
                                    @foreach (var message in inboxMessages)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <h6 class="mb-0 me-2">@message.Subject</h6>
                                                        @if (!message.IsRead)
                                                        {
                                                            <span class="badge bg-primary">New</span>
                                                        }
                                                    </div>
                                                    <p class="text-muted small mb-1">
                                                        From: @(string.IsNullOrEmpty(message.SenderName) ? "Unknown" : message.SenderName)
                                                        @if (message.ListingId.HasValue)
                                                        {
                                                            <span>• About Listing #@message.ListingId</span>
                                                        }
                                                    </p>
                                                    <p class="text-muted small mb-0">@message.SentAt.ToString("MMM dd, yyyy HH:mm")</p>
                                                </div>
                                                <div class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewMessage(message.Id)">
                                                        <i class="fa fa-eye"></i> View
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-inbox fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">No messages in inbox</h4>
                                <p class="text-muted">Messages from other users will appear here.</p>
                            </div>
                        }
                    </div>

                    <!-- Sent Tab -->
                    <div class="tab-pane fade" id="sent" role="tabpanel" aria-labelledby="sent-tab">
                        @if (sentMessages.Any())
                        {
                            <div class="card shadow">
                                <div class="list-group list-group-flush">
                                    @foreach (var message in sentMessages)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <h6 class="mb-0 me-2">@message.Subject</h6>
                                                        <span class="badge bg-success">Sent</span>
                                                    </div>
                                                    <p class="text-muted small mb-1">
                                                        To: @(string.IsNullOrEmpty(message.ReceiverName) ? "Unknown" : message.ReceiverName)
                                                        @if (message.ListingId.HasValue)
                                                        {
                                                            <span>• About Listing #@message.ListingId</span>
                                                        }
                                                    </p>
                                                    <p class="text-muted small mb-0">@message.SentAt.ToString("MMM dd, yyyy HH:mm")</p>
                                                </div>
                                                <div class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewMessage(message.Id)">
                                                        <i class="fa fa-eye"></i> View
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-paper-plane fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">No sent messages</h4>
                                <p class="text-muted">Messages you send will appear here.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa fa-envelope fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No messages yet</h4>
                    <p class="text-muted">Start a conversation by browsing car listings and contacting sellers.</p>
                    <a href="/" class="btn btn-primary">
                        <i class="fa fa-car me-2"></i>Browse Cars
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<MessageDto> messages = new();
    private List<MessageDto> inboxMessages = new();
    private List<MessageDto> sentMessages = new();
    private bool isLoading = true;
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        try
        {
            isLoading = true;
            inboxMessages = await MessageService.GetInboxMessagesAsync() ?? new List<MessageDto>();
            sentMessages = await MessageService.GetSentMessagesAsync() ?? new List<MessageDto>();
            messages = inboxMessages.Concat(sentMessages).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewMessage(int messageId)
    {
        NavigationManager.NavigateTo($"/message/{messageId}");
    }
}