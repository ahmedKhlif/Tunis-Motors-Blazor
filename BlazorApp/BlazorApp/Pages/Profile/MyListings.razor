@page "/profile/my-listings"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize(Roles = "Seller,Admin,Manager")]
@inject ICarListingService CarListingService
@inject IAuthService AuthService
@inject NavigationManager NavManager

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">My Listings</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li><a href="/seller-dashboard">Seller Dashboard</a></li>
                    <li class="active">My Listings</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fa fa-car me-2"></i>My Car Listings</h2>
                <button class="btn btn-success" @onclick='() => NavManager.NavigateTo("/create-listing")'>
                    <i class="fa fa-plus me-2"></i>Add New Car
                </button>
            </div>

            @if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3 text-muted">Loading your listings...</p>
                </div>
            }
            else if (listings != null && listings.Count > 0)
            {
                <div class="row">
                    @foreach (var car in listings)
                    {
                        <div class="col-xl-4 col-lg-6 mb-4">
                            <div class="card h-100 shadow">
                                <div class="position-relative">
                                    <img src="@GetImageUrl(car.Image)" class="card-img-top" alt="@car.Name"
                                         style="height: 200px; object-fit: cover;">
                                    @if (!car.IsApproved)
                                    {
                                        <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                            <i class="fa fa-clock"></i> Pending Approval
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success position-absolute top-0 start-0 m-2">
                                            <i class="fa fa-check"></i> Approved
                                        </span>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@car.Name</h5>
                                    <div class="mb-2">
                                        <span class="h6 text-success">@car.Price.ToString("N0") TND</span>
                                    </div>
                                    <div class="text-muted small mb-2">
                                        <div><i class="fa fa-calendar me-1"></i>@car.Year</div>
                                        <div><i class="fa fa-tachometer-alt me-1"></i>@car.Mileage.ToString("N0") km</div>
                                        <div><i class="fa fa-gas-pump me-1"></i>@car.FuelType</div>
                                        @if (!string.IsNullOrEmpty(car.Brand))
                                        {
                                            <div><i class="fa fa-tag me-1"></i>@car.Brand</div>
                                        }
                                        @if (!string.IsNullOrEmpty(car.Transmission))
                                        {
                                            <div><i class="fa fa-cog me-1"></i>@car.Transmission</div>
                                        }
                                    </div>
                                    <div class="mt-auto">
                                        <div class="row g-1">
                                            <div class="col-6">
                                                <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => ViewDetails(car.ProductId)">
                                                    <i class="fa fa-eye"></i> View
                                                </button>
                                            </div>
                                            <div class="col-6">
                                                <button class="btn btn-outline-warning btn-sm w-100" @onclick="() => EditListing(car.ProductId)">
                                                    <i class="fa fa-edit"></i> Edit
                                                </button>
                                            </div>
                                        </div>
                                        <div class="mt-2">
                                            @if (car.Category != null && !string.IsNullOrEmpty(car.Category.CategoryName))
                                            {
                                                <span class="badge bg-secondary">@car.Category.CategoryName</span>
                                            }
                                            @if (car.Rating > 0)
                                            {
                                                <span class="badge bg-info text-dark">
                                                    @for (int i = 0; i < car.Rating; i++)
                                                    {
                                                        <i class="fa fa-star"></i>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa fa-car fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No car listings yet</h4>
                    <p class="text-muted">Start selling by adding your first car listing.</p>
                    <button class="btn btn-primary btn-lg" @onclick='() => NavManager.NavigateTo("/create-listing")'>
                        <i class="fa fa-plus me-2"></i>Add Your First Car
                    </button>
                </div>
            }
        </div>
    </div>
    </div>
</div>
<!-- /SECTION -->

@code {
    private List<CarListingDto> listings = new();
    private bool isLoading = true;
    private string currentUserId;
    private string successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            currentUserId = user?.Id;
            await LoadListings();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading listings: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadListings()
    {
        if (!string.IsNullOrEmpty(currentUserId))
        {
            listings = await CarListingService.GetUserListingsAsync(currentUserId);
        }
    }

    private void ViewDetails(int productId)
    {
        NavManager.NavigateTo($"/product/{productId}");
    }

    private void EditListing(int productId)
    {
        NavManager.NavigateTo($"/edit-listing/{productId}");
    }

    private string GetImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
        {
            return "/images/noimage.jpg";
        }
        // If it's already a full URL, return as-is
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
        {
            return imagePath;
        }
        // Prepend API base URL
        var apiBaseUrl = "http://localhost:5237";
        if (imagePath.StartsWith("/"))
        {
            return $"{apiBaseUrl}{imagePath}";
        }
        return $"{apiBaseUrl}/images/{imagePath}";
    }
}
