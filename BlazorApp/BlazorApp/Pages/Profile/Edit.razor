@page "/edit-profile"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize]
@inject IUserService UserService
@inject NavigationManager NavigationManager

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Edit Profile</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li><a href="/profile">My Profile</a></li>
                    <li class="active">Edit Profile</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fa fa-user-edit me-2"></i>Edit Profile</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading profile...</p>
                        </div>
                    }
                    else if (profile != null)
                    {
                        <EditForm Model="editModel" OnValidSubmit="HandleUpdateProfile" FormName="editProfileForm">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <InputText id="firstName" class="form-control" @bind-Value="editModel.FirstName" placeholder="Enter your first name" />
                                    <ValidationMessage For="() => editModel.FirstName" class="text-danger" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <InputText id="lastName" class="form-control" @bind-Value="editModel.LastName" placeholder="Enter your last name" />
                                    <ValidationMessage For="() => editModel.LastName" class="text-danger" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <InputText id="email" type="email" class="form-control" @bind-Value="editModel.Email" readonly />
                                <div class="form-text">Email cannot be changed. Contact support if needed.</div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="phoneNumber" class="form-label">Phone Number</label>
                                    <InputText id="phoneNumber" class="form-control" @bind-Value="editModel.PhoneNumber" placeholder="+216 XX XXX XXX" />
                                    <ValidationMessage For="() => editModel.PhoneNumber" class="text-danger" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="dateOfBirth" class="form-label">Date of Birth</label>
                                    <InputDate id="dateOfBirth" class="form-control" @bind-Value="editModel.DateOfBirth" />
                                    <ValidationMessage For="() => editModel.DateOfBirth" class="text-danger" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label for="address" class="form-label">Address</label>
                                    <InputText id="address" class="form-control" @bind-Value="editModel.Address" placeholder="Street address" />
                                    <ValidationMessage For="() => editModel.Address" class="text-danger" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="city" class="form-label">City</label>
                                    <InputText id="city" class="form-control" @bind-Value="editModel.City" placeholder="City" />
                                    <ValidationMessage For="() => editModel.City" class="text-danger" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="country" class="form-label">Country</label>
                                    <InputText id="country" class="form-control" @bind-Value="editModel.Country" placeholder="Country" />
                                    <ValidationMessage For="() => editModel.Country" class="text-danger" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="bio" class="form-label">Bio</label>
                                    <InputTextArea id="bio" class="form-control" rows="3" @bind-Value="editModel.Bio" placeholder="Tell us about yourself..." />
                                    <ValidationMessage For="() => editModel.Bio" class="text-danger" />
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <text><span class="spinner-border spinner-border-sm me-2" role="status"></span>Updating...</text>
                                    }
                                    else
                                    {
                                        <text><i class="fa fa-save me-2"></i>Update Profile</text>
                                    }
                                </button>
                                <div class="d-flex gap-2">
                                    <a href="/profile" class="btn btn-outline-secondary flex-fill">
                                        <i class="fa fa-arrow-left me-2"></i>Back to Profile
                                    </a>
                                    <a href="/change-password" class="btn btn-outline-warning">
                                        <i class="fa fa-key me-2"></i>Change Password
                                    </a>
                                </div>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle me-2"></i>Failed to load profile information.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>
<!-- /SECTION -->

@code {
    private UserProfileDto profile;
    private EditProfileModel editModel = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            isLoading = true;
            profile = await UserService.GetCurrentUserProfileAsync();

            if (profile != null)
            {
                editModel = new EditProfileModel
                {
                    FirstName = profile.FirstName,
                    LastName = profile.LastName,
                    Email = profile.Email,
                    PhoneNumber = profile.PhoneNumber,
                    DateOfBirth = profile.DateOfBirth,
                    Address = profile.Address,
                    City = profile.City,
                    Country = profile.Country,
                    Bio = profile.Bio
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load profile.";
            Console.WriteLine($"Load profile error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdateProfile()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var updateDto = new UpdateUserProfileDto
            {
                FirstName = editModel.FirstName,
                LastName = editModel.LastName,
                PhoneNumber = editModel.PhoneNumber,
                Address = editModel.Address,
                City = editModel.City,
                Country = editModel.Country,
                DateOfBirth = editModel.DateOfBirth,
                Bio = editModel.Bio
            };
            var result = await UserService.UpdateProfileAsync(updateDto);
            if (result)
            {
                successMessage = "Profile updated successfully!";
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/profile");
            }
            else
            {
                errorMessage = "Failed to update profile.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Update profile error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class EditProfileModel
    {
        [StringLength(50, ErrorMessage = "First name cannot exceed 50 characters")]
        public string FirstName { get; set; } = "";

        [StringLength(50, ErrorMessage = "Last name cannot exceed 50 characters")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";

        [StringLength(20, ErrorMessage = "Phone number cannot exceed 20 characters")]
        [RegularExpression(@"^[\+]?[0-9\s\-\(\)]+$", ErrorMessage = "Please enter a valid phone number")]
        public string PhoneNumber { get; set; } = "";

        public DateTime? DateOfBirth { get; set; }

        [StringLength(200, ErrorMessage = "Address cannot exceed 200 characters")]
        public string Address { get; set; } = "";

        [StringLength(100, ErrorMessage = "City cannot exceed 100 characters")]
        public string City { get; set; } = "";

        [StringLength(100, ErrorMessage = "Country cannot exceed 100 characters")]
        public string Country { get; set; } = "";

        [StringLength(500, ErrorMessage = "Bio cannot exceed 500 characters")]
        public string Bio { get; set; } = "";
    }
}