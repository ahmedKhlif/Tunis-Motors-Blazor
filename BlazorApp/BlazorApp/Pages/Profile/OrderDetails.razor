@* This page is deprecated - use /order/details/{id} instead *@
@* @page "/order/{orderId:int}" *@
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize]
@inject IOrderService OrderService
@inject NavigationManager NavManager

<div class="container mt-4">
    @if (order != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h4>Order #@order.Id</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p><strong>Order Date:</strong> @order.OrderDate.ToString("g")</p>
                                <p><strong>Status:</strong> <span class="badge bg-info">@order.Status</span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Customer Name:</strong> @order.CustomerName</p>
                                <p><strong>Email:</strong> @order.Email</p>
                            </div>
                        </div>

                        <h5>Delivery Address</h5>
                        <p>@order.Address</p>

                        <h5>Payment Method</h5>
                        <p>@order.PaymentMethod</p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5>Order Items</h5>
                    </div>
                    <div class="card-body">
                        @if (order.Items != null && order.Items.Count > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Price</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.Items)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Price.ToString("C")</td>
                                            <td>@(item.Price * item.Quantity).ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card sticky-top">
                    <div class="card-header bg-light">
                        <h5>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>@order.TotalAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax:</span>
                            <span>--</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total:</strong>
                            <strong>@order.TotalAmount.ToString("C")</strong>
                        </div>

                        @if (order.Status == "Pending" || order.Status == "Confirmed")
                        {
                            <button class="btn btn-danger w-100" @onclick="() => CancelOrder(order.Id)">
                                Cancel Order
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <p>Loading order details...</p>
    }
</div>

@code {
    [Parameter]
    public int orderId { get; set; }

    private OrderDto order;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            order = await OrderService.GetOrderByIdAsync(orderId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task CancelOrder(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this order?"))
        {
            await OrderService.CancelOrderAsync(id);
            NavManager.NavigateTo("/orders");
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}
