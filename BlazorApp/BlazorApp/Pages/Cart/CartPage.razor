@page "/cart"
@using BlazorApp.Models
@using BlazorApp.Services
@using System.Text.Json
@inject ICartService CartService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Shopping Cart</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li class="active">Shopping Cart</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
<div class="container mt-5">
    <h1><i class="fa fa-shopping-cart"></i> Shopping Cart</h1>

    @if (isLoading)
    {
        <div class="alert alert-info">Loading cart...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (cart == null || cart.Items == null || !cart.Items.Any())
    {
        <div class="alert alert-warning">
            <p>Your cart is empty</p>
            <a href="/shop" class="btn btn-primary mt-2">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Cart Items (@cart.Items.Count)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cart.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.Product?.Image))
                                                {
                                                    <img src="@item.Product.Image" style="width: 60px; height: 60px; object-fit: cover; margin-right: 15px;" />
                                                }
                                                <div>
                                                    <a href="/product/@item.ProductId" class="text-decoration-none">@item.ProductName</a>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("N0") TND</td>
                                        <td>
                                            <div class="input-group" style="width: 100px;">
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateQuantity(item.Id, item.Quantity - 1)">-</button>
                                                <input type="text" class="form-control text-center" value="@item.Quantity" readonly />
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UpdateQuantity(item.Id, item.Quantity + 1)">+</button>
                                            </div>
                                        </td>
                                        <td><strong>@((item.Price * item.Quantity).ToString("N0")) TND</strong></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItem(item.Id)" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="/shop" class="btn btn-outline-primary me-2">
                        <i class="fa fa-arrow-left"></i> Continue Shopping
                    </a>
                    <button class="btn btn-outline-danger" @onclick="ClearCart">
                        <i class="fa fa-trash"></i> Clear Cart
                    </button>
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="col-lg-4">
                <div class="card position-sticky" style="top: 20px;">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>@cart.TotalAmount.ToString("N0") TND</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span>Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax (0%):</span>
                            <span>0 TND</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between" style="font-size: 1.2rem; font-weight: bold;">
                            <span>Total:</span>
                            <span class="text-danger">@cart.TotalAmount.ToString("N0") TND</span>
                        </div>

                        <button class="btn btn-danger w-100 mt-3" @onclick="ProceedToCheckout" disabled="@(cart.Items.Count == 0)">
                            <i class="fa fa-credit-card"></i> Proceed to Checkout
                        </button>

                        <p class="text-center mt-3 text-muted small">
                            <i class="fa fa-lock"></i> Secure checkout with Stripe
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
    </div>
</div>
<!-- /SECTION -->

@code {
    private CartDto cart;
    private bool isLoading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Check if user is logged in
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null)
        {
            NavigationManager.NavigateTo("/login?returnUrl=/cart");
            return;
        }

        await LoadCart();
    }

    private async Task LoadCart()
    {
        try
        {
            isLoading = true;
            errorMessage = "";

            var response = await CartService.GetCartAsync();
            if (response.Success)
            {
                cart = response.Data;
            }
            else
            {
                errorMessage = response.Message ?? "Failed to load cart";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading cart: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateQuantity(int itemId, int newQuantity)
    {
        if (newQuantity <= 0)
        {
            await RemoveItem(itemId);
            return;
        }

        try
        {
            var updateModel = new UpdateCartItemDto { Quantity = newQuantity };
            var response = await CartService.UpdateCartItemAsync(itemId, updateModel);

            if (response.Success)
            {
                cart = response.Data;
            }
            else
            {
                errorMessage = response.Message ?? "Failed to update quantity";
                await LoadCart(); // Reload to revert changes
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating quantity: {ex.Message}";
            await LoadCart(); // Reload to revert changes
        }
    }

    private async Task RemoveItem(int itemId)
    {
        try
        {
            var response = await CartService.RemoveFromCartAsync(itemId);

            if (response.Success)
            {
                await LoadCart(); // Reload cart after removal
            }
            else
            {
                errorMessage = response.Message ?? "Failed to remove item";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error removing item: {ex.Message}";
        }
    }

    private async Task ClearCart()
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to clear your entire cart?"))
        {
            try
            {
                var response = await CartService.ClearCartAsync();

                if (response.Success)
                {
                    await LoadCart(); // Reload cart after clearing
                }
                else
                {
                    errorMessage = response.Message ?? "Failed to clear cart";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error clearing cart: {ex.Message}";
            }
        }
    }

    private void ProceedToCheckout()
    {
        if (cart?.Items?.Any() != true)
            return;

        NavigationManager.NavigateTo("/checkout");
    }
}
