<!-- Alert Dialog -->
<AlertDialog IsVisible="@showAlert"
             Title="@alertTitle"
             Message="@alertMessage"
             Type="@alertType"
             OnClose="@CloseAlert" />

@code {
    private List<CarListingDto> featuredCars;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private string email = string.Empty;
    private bool showAlert = false;
    private string alertTitle = "";
    private string alertMessage = "";
    private AlertDialog.AlertType alertType = AlertDialog.AlertType.Info;
    private bool firstRender = true;
    private Dictionary<int, bool> compareStatus = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            
            // Check authentication
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            
            // Load featured cars
            var filter = new CarListingFilterDto { Page = 1, PageSize = 10 };
            var result = await CarListingService.GetAllListingsAsync(filter);
            featuredCars = result?.Data ?? new List<CarListingDto>();
            
            // Load compare status for all cars
            foreach (var car in featuredCars)
            {
                try
                {
                    compareStatus[car.Id] = await CompareService.IsInCompareAsync(car.Id);
                }
                catch
                {
                    compareStatus[car.Id] = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading featured cars: {ex.Message}");
            featuredCars = new List<CarListingDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialize sliders every time the page renders (not just first time)
        try
        {
            // Small delay to ensure DOM is ready
            await Task.Delay(100);
            
            // Initialize home slider
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (typeof $ !== 'undefined' && typeof $.fn.slick !== 'undefined') {
                    // Destroy existing slick instance if any
                    if ($('#home-slick').hasClass('slick-initialized')) {
                        $('#home-slick').slick('unslick');
                    }
                    
                    // Initialize home slider
                    $('#home-slick').slick({
                        autoplay: true,
                        autoplaySpeed: 4000,
                        arrows: true,
                        dots: true,
                        fade: true,
                        speed: 1000,
                        cssEase: 'cubic-bezier(0.7, 0, 0.3, 1)',
                        pauseOnHover: true,
                        pauseOnFocus: true
                    });

                    // Initialize products slider if exists
                    if ($('.products-slick').length) {
                        if ($('.products-slick').hasClass('slick-initialized')) {
                            $('.products-slick').slick('unslick');
                        }
                        $('.products-slick').slick({
                            slidesToShow: 4,
                            slidesToScroll: 1,
                            autoplay: true,
                            autoplaySpeed: 3000,
                            infinite: true,
                            speed: 300,
                            dots: true,
                            arrows: true,
                            responsive: [
                                { breakpoint: 1200, settings: { slidesToShow: 3 } },
                                { breakpoint: 991, settings: { slidesToShow: 2, dots: false } },
                                { breakpoint: 768, settings: { slidesToShow: 2, dots: false } },
                                { breakpoint: 480, settings: { slidesToShow: 1, dots: false, arrows: false } }
                            ]
                        });
                    }
                }
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing sliders: {ex.Message}");
        }
    }

    private async Task AddToWishlist(int carId)
    {
        try
        {
            var response = await WishlistService.AddToWishlistAsync(carId);
            if (response)
            {
                ShowAlert("Success", "Added to wishlist!", AlertDialog.AlertType.Success);
            }
            else
            {
                ShowAlert("Error", "Failed to add to wishlist", AlertDialog.AlertType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowAlert("Error", ex.Message, AlertDialog.AlertType.Error);
        }
    }

    private void QuickView(int carId)
    {
        Navigation.NavigateTo($"/product/{carId}");
    }

    private async Task AddToCart(int carId)
    {
        try
        {
            var addToCartModel = new AddToCartDto { ProductId = carId, Quantity = 1 };
            var response = await CartService.AddToCartAsync(addToCartModel);
            if (response.Success)
            {
                ShowAlert("Success", "Added to cart!", AlertDialog.AlertType.Success);
            }
            else
            {
                ShowAlert("Error", "Failed to add to cart", AlertDialog.AlertType.Error);
            }
        }
        catch (Exception ex)
        {
            ShowAlert("Error", ex.Message, AlertDialog.AlertType.Error);
        }
    }

    private async Task ToggleCompare(CarListingDto car)
    {
        try
        {
            var isInCompare = compareStatus.ContainsKey(car.Id) && compareStatus[car.Id];
            if (isInCompare)
            {
                await CompareService.RemoveFromCompareAsync(car.Id);
                compareStatus[car.Id] = false;
                ShowAlert("Success", "Removed from compare", AlertDialog.AlertType.Success);
            }
            else
            {
                var added = await CompareService.AddToCompareAsync(car);
                if (added)
                {
                    compareStatus[car.Id] = true;
                    ShowAlert("Success", "Added to compare", AlertDialog.AlertType.Success);
                }
                else
                {
                    ShowAlert("Info", "Compare list is full (max 4 cars). Remove a car first.", AlertDialog.AlertType.Info);
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowAlert("Error", "Error updating compare list.", AlertDialog.AlertType.Error);
            Console.WriteLine($"Compare error: {ex.Message}");
        }
    }

    private void ShowAlert(string title, string message, AlertDialog.AlertType type)
    {
        alertTitle = title;
        alertMessage = message;
        alertType = type;
        showAlert = true;
    }

    private void CloseAlert()
    {
        showAlert = false;
    }

    private async Task HandleSubscribe()
    {
        try
        {
            email = string.Empty;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Subscribe error: {ex.Message}");
        }
    }

    private string GetImageUrl(string imagePath)
    {
        var apiBaseUrl = "http://localhost:5237";
        if (string.IsNullOrEmpty(imagePath)) return "./images/noimage.jpg";
        if (imagePath.StartsWith("/images/"))
            return $"{apiBaseUrl}{imagePath}";
        return $"{apiBaseUrl}/images/{imagePath}";
    }
