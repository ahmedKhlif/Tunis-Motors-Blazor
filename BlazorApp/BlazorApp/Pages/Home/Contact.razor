@page "/contact"
@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JSRuntime

<PageTitle>Contact Us - Tunisia Motors</PageTitle>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Contact Us</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-8">
            <h1 class="display-4 mb-4">Contact Us</h1>
            <p class="lead">Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.</p>
        </div>
        <div class="col-lg-4">
            <img src="/images/contact.jpg" alt="Contact Us" class="img-fluid rounded shadow" style="width: 100%; height: 200px; object-fit: cover;">
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-4">Send us a Message</h2>
                    
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fa fa-check-circle me-2"></i>@successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                        </div>
                    }
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fa fa-exclamation-circle me-2"></i>@errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    <EditForm Model="@contactForm" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="firstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="contactForm.FirstName" class="form-control" id="firstName" placeholder="Enter your first name" />
                                <ValidationMessage For="@(() => contactForm.FirstName)" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="lastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="contactForm.LastName" class="form-control" id="lastName" placeholder="Enter your last name" />
                                <ValidationMessage For="@(() => contactForm.LastName)" class="text-danger" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                            <InputText @bind-Value="contactForm.Email" type="email" class="form-control" id="email" placeholder="your.email@example.com" />
                            <ValidationMessage For="@(() => contactForm.Email)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number</label>
                            <InputText @bind-Value="contactForm.Phone" class="form-control" id="phone" placeholder="+216 XX XXX XXX" />
                        </div>

                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject <span class="text-danger">*</span></label>
                            <InputText @bind-Value="contactForm.Subject" class="form-control" id="subject" placeholder="What is this regarding?" />
                            <ValidationMessage For="@(() => contactForm.Subject)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label for="message" class="form-label">Message <span class="text-danger">*</span></label>
                            <InputTextArea @bind-Value="contactForm.Message" class="form-control" id="message" rows="5" placeholder="Tell us more about your inquiry..." />
                            <ValidationMessage For="@(() => contactForm.Message)" class="text-danger" />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <i class="fa fa-paper-plane me-2"></i>
                                <span>Send Message</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fa fa-map-marker-alt text-primary me-2"></i>Address</h5>
                    <p class="card-text">
                        Tunisia Motors<br>
                        123 Avenue Habib Bourguiba<br>
                        1000 Tunis, Tunisia
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fa fa-phone text-success me-2"></i>Phone</h5>
                    <p class="card-text">
                        <a href="tel:+216955184" class="text-decoration-none">+216 95 518 4</a><br>
                        <small class="text-muted">Mon-Fri: 9:00 AM - 6:00 PM</small>
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fa fa-envelope text-info me-2"></i>Email</h5>
                    <p class="card-text">
                        <a href="mailto:contact@carecommerce.tn" class="text-decoration-none">contact@carecommerce.tn</a><br>
                        <small class="text-muted">We'll respond within 24 hours</small>
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fa fa-share-alt text-warning me-2"></i>Follow Us</h5>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-primary btn-sm"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-outline-info btn-sm"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="btn btn-outline-danger btn-sm"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="btn btn-outline-primary btn-sm"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ContactFormModel contactForm = new();
    private bool isSubmitting = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            // Simulate API call
            await Task.Delay(1000);

            // In a real application, you would send this to your API
            // For now, we'll just show a success message
            successMessage = "Thank you for contacting us! We'll get back to you within 24 hours.";
            
            // Reset form
            contactForm = new();
            
            await JSRuntime.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while sending your message. Please try again later.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "First name is required")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;

        public string? Phone { get; set; }

        [Required(ErrorMessage = "Subject is required")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "Message is required")]
        [MinLength(10, ErrorMessage = "Message must be at least 10 characters")]
        public string Message { get; set; } = string.Empty;
    }
}
