@page "/seller-dashboard"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize(Roles = "Seller,Admin,Manager")]
@inject ICarListingService CarListingService
@inject IOrderService OrderService
@inject IAuthService AuthService
@inject IPurchaseRequestService PurchaseRequestService
@inject ICarRentalService CarRentalService
@inject NavigationManager NavManager

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Seller Dashboard</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li class="active">Seller Dashboard</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1"><i class="fa fa-user-tie me-2 text-primary"></i>Seller Dashboard</h1>
                    <p class="text-muted">Welcome back, @sellerName 👋</p>
                </div>
                <button class="btn btn-success btn-lg" @onclick='() => NavManager.NavigateTo("/create-listing")'>
                    <i class="fa fa-plus me-2"></i>Add New Car Listing
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading your dashboard data...</p>
        </div>
    }
    else
    {
        <!-- Quick Stats Row -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Active Listings</p>
                                <h3 class="mb-0 text-primary">@activeListings</h3>
                            </div>
                            <div class="stat-icon bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-car fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Pending Approval</p>
                                <h3 class="mb-0 text-warning">@pendingListings</h3>
                            </div>
                            <div class="stat-icon bg-warning bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-clock fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Purchase Requests</p>
                                <h3 class="mb-0 text-success">@(purchaseRequests?.Count(p => !p.IsResolved) ?? 0)</h3>
                            </div>
                            <div class="stat-icon bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-handshake fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Total Revenue</p>
                                <h3 class="mb-0 text-danger">@totalRevenue.ToString("N0") TND</h3>
                            </div>
                            <div class="stat-icon bg-danger bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-money-bill-wave fa-2x text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Active Rentals</p>
                                <h3 class="mb-0 text-info">@activeRentals</h3>
                            </div>
                            <div class="stat-icon bg-info bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-calendar-check fa-2x text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Pending Rentals</p>
                                <h3 class="mb-0 text-warning">@pendingRentals</h3>
                            </div>
                            <div class="stat-icon bg-warning bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-hourglass-half fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Rental Revenue</p>
                                <h3 class="mb-0 text-success">@rentalRevenue.ToString("N0") TND</h3>
                            </div>
                            <div class="stat-icon bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-chart-line fa-2x text-success"></i>
                            </div>
                        </div>
                        <small class="text-muted">This Month</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Overdue Returns</p>
                                <h3 class="mb-0 @((overdueRentals > 0) ? "text-danger" : "text-success")">@overdueRentals</h3>
                            </div>
                            <div class="stat-icon @((overdueRentals > 0) ? "bg-danger" : "bg-success") bg-opacity-10 rounded-circle p-3">
                                <i class="fa @((overdueRentals > 0) ? "fa-exclamation-triangle" : "fa-check-circle") fa-2x @((overdueRentals > 0) ? "text-danger" : "text-success")"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Row -->
        <div class="row">
            <!-- Left Column: Recent Listings & Activity -->
            <div class="col-lg-8 mb-4">
                <!-- Recent Listings -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0"><i class="fa fa-car me-2 text-primary"></i>Your Recent Listings</h5>
                        <a href="/profile/my-listings" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        @if (listings != null && listings.Count > 0)
                        {
                            <div class="row">
                                @foreach (var listing in listings.Take(3))
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="listing-card border rounded-3 overflow-hidden h-100 transition">
                                            <div class="position-relative">
                                                <img src="@GetImageUrl(listing.Image)" class="img-fluid" alt="@listing.Name"
                                                     style="height: 180px; width: 100%; object-fit: cover;">
                                                @if (!listing.IsApproved)
                                                {
                                                    <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">
                                                        <i class="fa fa-hourglass-end"></i> Pending
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success position-absolute top-0 start-0 m-2">
                                                        <i class="fa fa-check-circle"></i> Active
                                                    </span>
                                                }
                                            </div>
                                            <div class="p-3">
                                                <h6 class="mb-1 text-truncate">@listing.Name</h6>
                                                <p class="text-primary fw-bold mb-2">@listing.Price.ToString("N0") TND</p>
                                                <div class="small text-muted mb-2">
                                                    <div><i class="fa fa-calendar me-1"></i>@listing.Year</div>
                                                    <div><i class="fa fa-tachometer-alt me-1"></i>@listing.Mileage.ToString("N0") km</div>
                                                </div>
                                                <div class="d-grid gap-2">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewListingDetails(listing.ProductId)">
                                                        <i class="fa fa-eye me-1"></i>View Details
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No listings yet. Start by creating your first car listing!</p>
                                <button class="btn btn-primary" @onclick='() => NavManager.NavigateTo("/create-listing")'>
                                    <i class="fa fa-plus me-2"></i>Add New Listing
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Purchase Requests Section -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0"><i class="fa fa-handshake me-2 text-success"></i>Purchase Requests</h5>
                        <span class="badge bg-success">@(purchaseRequests?.Count(p => !p.IsResolved) ?? 0)</span>
                    </div>
                    <div class="card-body">
                        @if (purchaseRequests != null && purchaseRequests.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Car</th>
                                            <th>Buyer</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var request in purchaseRequests.Take(5))
                                        {
                                            <tr>
                                                <td>
                                                    <small class="fw-semibold">@request.CarListingName</small>
                                                </td>
                                                <td>
                                                    <small>@request.CustomerName</small>
                                                </td>
                                                <td>
                                                    @if (request.IsResolved)
                                                    {
                                                        <span class="badge bg-secondary">Resolved</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">New</span>
                                                    }
                                                </td>
                                                <td>
                                                    <small>@request.CreatedAt.ToString("MMM dd, yyyy")</small>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewPurchaseRequest(request)">
                                                        <i class="fa fa-eye"></i> View
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No purchase requests yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Stats & Quick Actions -->
            <div class="col-lg-4">
                <!-- Performance Card -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 py-3">
                        <h5 class="mb-0"><i class="fa fa-chart-line me-2 text-info"></i>Performance</h5>
                    </div>
                    <div class="card-body">
                        <div class="performance-metric mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small">Listings Approved</span>
                                <span class="badge bg-success">@approvedListings/@listings.Count</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: @GetApprovalPercentage()%"></div>
                            </div>
                        </div>

                        <div class="performance-metric">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small">Average Price</span>
                                <span class="fw-semibold">@averagePrice.ToString("N0") TND</span>
                            </div>
                            <p class="text-muted small mb-0">Across @listings.Count listings</p>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions Card -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 py-3">
                        <h5 class="mb-0"><i class="fa fa-bolt me-2 text-warning"></i>Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" @onclick='() => NavManager.NavigateTo("/create-listing")'>
                                <i class="fa fa-plus me-2"></i>Create New Listing
                            </button>
                            <button class="btn btn-outline-success" @onclick='() => NavManager.NavigateTo("/profile/my-listings")'>
                                <i class="fa fa-list me-2"></i>View All Listings
                            </button>
                            <button class="btn btn-outline-info" @onclick='() => NavManager.NavigateTo("/my-rentals")'>
                                <i class="fa fa-calendar me-2"></i>Rental Management
                            </button>
                            <button class="btn btn-outline-warning" @onclick='() => NavManager.NavigateTo("/profile")'>
                                <i class="fa fa-user me-2"></i>Edit Profile
                            </button>
                            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/profile/my-messages")'>
                                <i class="fa fa-envelope me-2"></i>Messages
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Help & Support -->
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body text-center py-4">
                        <i class="fa fa-question-circle fa-2x text-muted mb-3"></i>
                        <h6 class="mb-2">Need Help?</h6>
                        <p class="small text-muted mb-3">Check our seller guide for tips on selling your car faster.</p>
                        <a href="#" class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-book me-1"></i>Seller Guide
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>

<!-- Purchase Request Modal -->
@if (selectedPurchaseRequest != null)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Purchase Request Details</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedPurchaseRequest = null"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Car</label>
                        <p class="form-control-plaintext">@selectedPurchaseRequest.CarListingName</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Buyer Name</label>
                        <p class="form-control-plaintext">@selectedPurchaseRequest.CustomerName</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Message</label>
                        <p class="form-control-plaintext">@selectedPurchaseRequest.Message</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Requested at</label>
                        <p class="form-control-plaintext">@selectedPurchaseRequest.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" @onclick="() => selectedPurchaseRequest = null">Close</button>
                </div>
            </div>
        </div>
    </div>
    }
</div>
<!-- /SECTION -->

<style>
    .stat-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }

    .stat-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 80px;
        height: 80px;
    }

    .listing-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .listing-card:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        transform: translateY(-3px);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0,0,0,0.02);
    }

    .performance-metric {
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .performance-metric:last-child {
        border-bottom: none;
    }

    .transition {
        transition: all 0.3s ease;
    }
</style>

@code {
    private List<CarListingDto> listings = new();
    private List<PurchaseRequestDto> purchaseRequests = new();
    private PurchaseRequestDto selectedPurchaseRequest;
    private bool isLoading = true;
    private string currentUserId;
    private string sellerName = "Seller";
    
    // Statistics
    private int activeListings = 0;
    private int pendingListings = 0;
    private int approvedListings = 0;
    private decimal totalRevenue = 0;
    private decimal averagePrice = 0;
    private int activeRentals = 0;
    private int pendingRentals = 0;
    private int overdueRentals = 0;
    private decimal rentalRevenue = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null)
            {
                NavManager.NavigateTo("/login");
                return;
            }

            currentUserId = user.Id;
            sellerName = user.Profile?.FirstName ?? user.UserName ?? "Seller";

            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Load listings
            listings = await CarListingService.GetUserListingsAsync(currentUserId);
            
            // Calculate stats
            activeListings = listings.Count(l => l.IsApproved);
            pendingListings = listings.Count(l => !l.IsApproved);
            approvedListings = activeListings;
            
            if (listings.Count > 0)
            {
                averagePrice = listings.Average(l => l.Price);
            }

            // Load purchase requests
            purchaseRequests = await PurchaseRequestService.GetSellerPurchaseRequestsAsync(currentUserId);

            // Calculate total revenue from purchase requests
            if (purchaseRequests != null)
            {
                totalRevenue = purchaseRequests
                    .Where(p => p.IsResolved)
                    .Sum(p => p.CarListingPrice);
            }

            // Load rental statistics
            var rentalStatsResponse = await CarRentalService.GetRentalStatisticsAsync();
            if (rentalStatsResponse.Success)
            {
                activeRentals = rentalStatsResponse.Data.ActiveRentals;
                pendingRentals = rentalStatsResponse.Data.PendingRequests;
                overdueRentals = rentalStatsResponse.Data.OverdueRentals;
                rentalRevenue = rentalStatsResponse.Data.MonthlyRevenue;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    private string GetImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
        {
            return "/images/noimage.jpg";
        }
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
        {
            return imagePath;
        }
        var apiBaseUrl = "http://localhost:5237";
        if (imagePath.StartsWith("/"))
        {
            return $"{apiBaseUrl}{imagePath}";
        }
        return $"{apiBaseUrl}/images/{imagePath}";
    }

    private double GetApprovalPercentage()
    {
        if (listings.Count == 0) return 0;
        return (double)approvedListings / listings.Count * 100;
    }

    private void ViewListingDetails(int productId)
    {
        NavManager.NavigateTo($"/product/{productId}");
    }

    private void ViewPurchaseRequest(PurchaseRequestDto request)
    {
        selectedPurchaseRequest = request;
    }
}
}