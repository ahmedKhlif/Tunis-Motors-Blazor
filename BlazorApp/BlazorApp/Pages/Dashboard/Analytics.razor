@page "/analytics"
@using BlazorApp.Services
@using BlazorApp.Models
@using Microsoft.JSInterop
@using System.Text.Json
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IDashboardService DashboardService
@inject IJSRuntime JSRuntime

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="breadcrumb-header">Analytics Dashboard</h3>
                        <ul class="breadcrumb-tree">
                            <li><a href="/">Home</a></li>
                            <li><a href="/admin">Dashboard</a></li>
                            <li class="active">Analytics</li>
                        </ul>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-success" @onclick="ExportToPDF" disabled="@isExporting">
                            <i class="fa fa-file-pdf"></i> Export PDF
                        </button>
                        <button class="btn btn-primary" @onclick="ExportToExcel" disabled="@isExporting">
                            <i class="fa fa-file-excel"></i> Export Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECTION -->
<div class="section">
    <div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1"><i class="fa fa-chart-bar me-2 text-primary"></i>Analytics Dashboard</h1>
                    <p class="text-muted mb-0">Comprehensive insights into your car marketplace performance</p>
                </div>
                <div class="text-end">
                    <small class="text-muted">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</small>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading analytics data...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fa fa-exclamation-triangle me-2"></i>
            <strong>Error:</strong> @errorMessage
            <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadDataAsync">
                <i class="fa fa-redo me-1"></i>Retry
            </button>
        </div>
    }
    else if (analytics == null)
    {
        <div class="alert alert-warning" role="alert">
            <i class="fa fa-info-circle me-2"></i>
            No analytics data available.
        </div>
    }
    else
    {
        <!-- Key Performance Indicators -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #10b981 !important;">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                    <i class="fa fa-dollar-sign fa-2x text-success"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Total Revenue</h6>
                                <h4 class="mb-0">@analytics.TotalRevenue.ToString("N0") TND</h4>
                                @if (GetRevenueGrowth() != 0)
                                {
                                    <small class="@(GetRevenueGrowth() > 0 ? "text-success" : "text-danger")">
                                        <i class="fa @(GetRevenueGrowth() > 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                        @Math.Abs(GetRevenueGrowth()).ToString("F1")% vs last month
                                    </small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #3b82f6 !important;">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                    <i class="fa fa-chart-line fa-2x text-primary"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Monthly Revenue</h6>
                                <h4 class="mb-0">@GetCurrentMonthRevenue().ToString("N0") TND</h4>
                                <small class="text-muted">@DateTime.Now.ToString("MMMM yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #f59e0b !important;">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                    <i class="fa fa-car fa-2x text-warning"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Total Listings</h6>
                                <h4 class="mb-0">@analytics.PopularBrands.Sum(b => b.Count)</h4>
                                <small class="text-muted">@analytics.PopularBrands.Count brands</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #8b5cf6 !important;">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                                    <i class="fa fa-tags fa-2x text-info"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">Categories</h6>
                                <h4 class="mb-0">@analytics.ListingsByCategory.Count</h4>
                                <small class="text-muted">Active categories</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average Revenue Card -->
        <div class="row mb-4">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-block mb-3">
                            <i class="fa fa-chart-bar fa-3x text-success"></i>
                        </div>
                        <h6 class="text-muted mb-2">Average Monthly Revenue</h6>
                        <h3 class="text-success mb-0">@GetAverageMonthlyRevenue().ToString("N0") TND</h3>
                        <small class="text-muted">Last 12 months</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-inline-block mb-3">
                            <i class="fa fa-trophy fa-3x text-primary"></i>
                        </div>
                        <h6 class="text-muted mb-2">Best Selling Brand</h6>
                        <h3 class="text-primary mb-0">@GetTopBrand()</h3>
                        <small class="text-muted">@GetTopBrandCount() listings</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 d-inline-block mb-3">
                            <i class="fa fa-star fa-3x text-warning"></i>
                        </div>
                        <h6 class="text-muted mb-2">Top Category</h6>
                        <h3 class="text-warning mb-0">@GetTopCategory()</h3>
                        <small class="text-muted">@GetTopCategoryCount() listings</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="row mb-4">
            <!-- Popular Brands Chart -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fa fa-car me-2"></i>Popular Brands</h5>
                    </div>
                    <div class="card-body">
                        @if (analytics.PopularBrands.Any())
                        {
                            <div style="height: 300px;">
                                <canvas id="brandsChart"></canvas>
                            </div>
                            <div class="text-center mt-3">
                                <small class="text-muted">Distribution of car brands in listings</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-car fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No brand data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Category Distribution Chart -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fa fa-tags me-2"></i>Category Distribution</h5>
                    </div>
                    <div class="card-body">
                        @if (analytics.ListingsByCategory.Any())
                        {
                            <div style="height: 300px;">
                                <canvas id="categoriesChart"></canvas>
                            </div>
                            <div class="text-center mt-3">
                                <small class="text-muted">Listings distribution across categories</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-tags fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No category data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Trend Chart -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fa fa-chart-line me-2"></i>Revenue Trends</h5>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px;">
                            <canvas id="revenueChart"></canvas>
                        </div>
                        <div class="text-center mt-3">
                            <small class="text-muted">Monthly revenue performance over the last 12 months</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Charts Row -->
        <div class="row mb-4">
            <!-- User Registrations Trend -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fa fa-users me-2"></i>User Growth Trend</h5>
                    </div>
                    <div class="card-body">
                        @if (analytics.UserRegistrations != null && analytics.UserRegistrations.Any())
                        {
                            <div style="height: 300px;">
                                <canvas id="userGrowthChart"></canvas>
                            </div>
                            <div class="text-center mt-3">
                                <small class="text-muted">Monthly user registration trends</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-users fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No user registration data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Revenue vs Listings Comparison -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0"><i class="fa fa-balance-scale me-2"></i>Revenue vs Listings</h5>
                    </div>
                    <div class="card-body">
                        <div style="height: 300px;">
                            <canvas id="comparisonChart"></canvas>
                        </div>
                        <div class="text-center mt-3">
                            <small class="text-muted">Correlation between listings and revenue</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Metrics Row -->
        <div class="row mb-4">
            <!-- Average Revenue Per Brand -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fa fa-chart-bar me-2"></i>Revenue Per Brand</h5>
                    </div>
                    <div class="card-body">
                        @if (analytics.PopularBrands != null && analytics.PopularBrands.Any())
                        {
                            <div style="height: 300px;">
                                <canvas id="revenuePerBrandChart"></canvas>
                            </div>
                            <div class="text-center mt-3">
                                <small class="text-muted">Average revenue contribution by brand</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-chart-bar fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No brand revenue data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Category Performance Radar -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg h-100">
                    <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <h5 class="mb-0"><i class="fa fa-radar me-2"></i>Category Performance</h5>
                    </div>
                    <div class="card-body">
                        @if (analytics.ListingsByCategory != null && analytics.ListingsByCategory.Any())
                        {
                            <div style="height: 300px;">
                                <canvas id="categoryRadarChart"></canvas>
                            </div>
                            <div class="text-center mt-3">
                                <small class="text-muted">Multi-dimensional category analysis</small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-chart-area fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No category performance data available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Analytics -->
        <div class="row mb-4">
            <!-- Brand Performance Table -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fa fa-trophy me-2"></i>Brand Performance</h5>
                        <span class="badge bg-light text-dark">@analytics.PopularBrands.Count brands</span>
                    </div>
                    <div class="card-body p-0">
                        @if (analytics.PopularBrands.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="border-0">Brand</th>
                                            <th class="border-0 text-center">Listings</th>
                                            <th class="border-0 text-center">Market Share</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var brand in analytics.PopularBrands)
                                        {
                                            var totalListings = analytics.PopularBrands.Sum(b => b.Count);
                                            var marketShare = totalListings > 0 ? (brand.Count * 100.0) / totalListings : 0;
                                            <tr>
                                                <td class="fw-medium">
                                                    <i class="fa fa-car me-2 text-primary"></i>@brand.Brand
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary">@brand.Count</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@marketShare.ToString("F1")%</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-chart-bar fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No brand analytics available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Category Distribution Table -->
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fa fa-pie-chart me-2"></i>Category Distribution</h5>
                        <span class="badge bg-light text-dark">@analytics.ListingsByCategory.Count categories</span>
                    </div>
                    <div class="card-body p-0">
                        @if (analytics.ListingsByCategory.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="border-0">Category</th>
                                            <th class="border-0 text-center">Listings</th>
                                            <th class="border-0 text-center">Percentage</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var category in analytics.ListingsByCategory)
                                        {
                                            var totalListings = analytics.ListingsByCategory.Sum(c => c.Count);
                                            var percentage = totalListings > 0 ? (category.Count * 100.0) / totalListings : 0;
                                            <tr>
                                                <td class="fw-medium">
                                                    <i class="fa fa-tag me-2 text-warning"></i>@category.Category
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-warning text-dark">@category.Count</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-info">@percentage.ToString("F1")%</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-pie-chart fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No category analytics available</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-gradient-primary text-white">
                        <h5 class="mb-0"><i class="fa fa-lightbulb me-2"></i>Key Insights</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="text-center">
                                    <i class="fa fa-trending-up fa-2x text-success mb-2"></i>
                                    <h6>Revenue Growth</h6>
                                    <p class="text-muted small">Track monthly revenue trends to identify growth patterns</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="text-center">
                                    <i class="fa fa-users fa-2x text-primary mb-2"></i>
                                    <h6>User Engagement</h6>
                                    <p class="text-muted small">Monitor user activity and platform adoption rates</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="text-center">
                                    <i class="fa fa-car fa-2x text-warning mb-2"></i>
                                    <h6>Market Trends</h6>
                                    <p class="text-muted small">Analyze popular brands and categories for inventory planning</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>

@code {
    private DashboardAnalyticsDto? analytics;
    private bool isLoading = true;
    private string? errorMessage;
    private bool chartsInitialized = false;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private decimal GetRevenueGrowth()
    {
        if (analytics?.MonthlyRevenueData == null || analytics.MonthlyRevenueData.Count < 2)
            return 0;

        var currentMonth = analytics.MonthlyRevenueData.LastOrDefault()?.Revenue ?? 0;
        var previousMonth = analytics.MonthlyRevenueData.Skip(analytics.MonthlyRevenueData.Count - 2).FirstOrDefault()?.Revenue ?? 0;

        if (previousMonth == 0) return 0;

        return ((currentMonth - previousMonth) / previousMonth) * 100;
    }

    private decimal GetAverageMonthlyRevenue()
    {
        if (analytics?.MonthlyRevenueData == null || !analytics.MonthlyRevenueData.Any())
            return 0;

        return analytics.MonthlyRevenueData.Average(r => r.Revenue);
    }

    private string GetTopBrand()
    {
        return analytics?.PopularBrands?.OrderByDescending(b => b.Count).FirstOrDefault()?.Brand ?? "N/A";
    }

    private int GetTopBrandCount()
    {
        return analytics?.PopularBrands?.OrderByDescending(b => b.Count).FirstOrDefault()?.Count ?? 0;
    }

    private string GetTopCategory()
    {
        return analytics?.ListingsByCategory?.OrderByDescending(c => c.Count).FirstOrDefault()?.Category ?? "N/A";
    }

    private int GetTopCategoryCount()
    {
        return analytics?.ListingsByCategory?.OrderByDescending(c => c.Count).FirstOrDefault()?.Count ?? 0;
    }

    private decimal GetCurrentMonthRevenue()
    {
        // First try to get from MonthlyRevenue field
        if (analytics?.MonthlyRevenue > 0)
            return analytics.MonthlyRevenue;

        // Fallback: Get from MonthlyRevenueData (last item should be current month)
        if (analytics?.MonthlyRevenueData != null && analytics.MonthlyRevenueData.Any())
            return analytics.MonthlyRevenueData.LastOrDefault()?.Revenue ?? 0;

        return 0;
    }

    private async Task ExportToPDF()
    {
        try
        {
            isExporting = true;
            StateHasChanged();

            // Generate export data
            var exportData = new
            {
                GeneratedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                TotalRevenue = analytics?.TotalRevenue.ToString("N2"),
                MonthlyRevenue = GetCurrentMonthRevenue().ToString("N2"),
                AverageMonthlyRevenue = GetAverageMonthlyRevenue().ToString("N2"),
                RevenueGrowth = GetRevenueGrowth().ToString("F1") + "%",
                TotalListings = analytics?.PopularBrands.Sum(b => b.Count),
                TopBrand = GetTopBrand(),
                TopBrandCount = GetTopBrandCount(),
                TopCategory = GetTopCategory(),
                TopCategoryCount = GetTopCategoryCount(),
                Brands = analytics?.PopularBrands,
                Categories = analytics?.ListingsByCategory,
                MonthlyRevenueData = analytics?.MonthlyRevenueData
            };

            var json = JsonSerializer.Serialize(exportData, new JsonSerializerOptions { WriteIndented = true });
            
            await JSRuntime.InvokeVoidAsync("downloadAnalyticsReport", "pdf", json);
            
            Console.WriteLine("PDF export initiated successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to PDF: {ex.Message}");
            errorMessage = "Failed to export PDF. Please try again.";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            isExporting = true;
            StateHasChanged();

            var exportData = new
            {
                Summary = new
                {
                    GeneratedDate = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
                    TotalRevenue = analytics?.TotalRevenue,
                    MonthlyRevenue = GetCurrentMonthRevenue(),
                    AverageMonthlyRevenue = GetAverageMonthlyRevenue(),
                    RevenueGrowth = GetRevenueGrowth(),
                    TotalListings = analytics?.PopularBrands.Sum(b => b.Count),
                    TotalBrands = analytics?.PopularBrands.Count,
                    TotalCategories = analytics?.ListingsByCategory.Count
                },
                TopPerformers = new
                {
                    TopBrand = GetTopBrand(),
                    TopBrandCount = GetTopBrandCount(),
                    TopCategory = GetTopCategory(),
                    TopCategoryCount = GetTopCategoryCount()
                },
                Brands = analytics?.PopularBrands?.Select(b => new { b.Brand, b.Count }),
                Categories = analytics?.ListingsByCategory?.Select(c => new { c.Category, c.Count }),
                MonthlyRevenueData = analytics?.MonthlyRevenueData?.Select(m => new { m.Month, Revenue = m.Revenue })
            };

            var json = JsonSerializer.Serialize(exportData, new JsonSerializerOptions { WriteIndented = true });
            
            await JSRuntime.InvokeVoidAsync("downloadAnalyticsReport", "excel", json);
            
            Console.WriteLine("Excel export initiated successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
            errorMessage = "Failed to export Excel. Please try again.";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && analytics != null && !chartsInitialized)
        {
            await InitializeChartsAsync();
            chartsInitialized = true;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            Console.WriteLine("Loading analytics data...");
            
            analytics = await DashboardService.GetAnalyticsAsync();
            
            Console.WriteLine($"Analytics loaded: Brands={analytics?.PopularBrands?.Count ?? 0}, Categories={analytics?.ListingsByCategory?.Count ?? 0}");
            
            isLoading = false;
            
            // Force re-render to trigger chart initialization
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading analytics: {ex.Message}");
            errorMessage = $"Failed to load analytics: {ex.Message}";
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task InitializeChartsAsync()
    {
        try
        {
            Console.WriteLine("Starting chart initialization...");
            
            // Wait a bit for DOM to be ready
            await Task.Delay(100);
            
            // Check if Chart.js is loaded
            var chartJsLoaded = await JSRuntime.InvokeAsync<bool>("eval", "typeof Chart !== 'undefined'");
            if (!chartJsLoaded)
            {
                Console.WriteLine("Chart.js not loaded yet!");
                await Task.Delay(500);
            }
            
            // Prepare brands chart data
            if (analytics?.PopularBrands != null && analytics.PopularBrands.Any())
            {
                var brandsLabels = analytics.PopularBrands.Take(8).Select(b => b.Brand).ToArray();
                var brandsData = analytics.PopularBrands.Take(8).Select(b => b.Count).ToArray();
                
                Console.WriteLine($"Initializing brands chart with {brandsLabels.Length} brands");
                await JSRuntime.InvokeVoidAsync("initializeDoughnutChart", "brandsChart", brandsLabels, brandsData);
            }
            
            // Prepare categories chart data
            if (analytics?.ListingsByCategory != null && analytics.ListingsByCategory.Any())
            {
                var categoriesLabels = analytics.ListingsByCategory.Select(c => c.Category).ToArray();
                var categoriesData = analytics.ListingsByCategory.Select(c => c.Count).ToArray();
                
                Console.WriteLine($"Initializing categories chart with {categoriesLabels.Length} categories");
                await JSRuntime.InvokeVoidAsync("initializeBarChart", "categoriesChart", categoriesLabels, categoriesData);
            }
            
            // Prepare revenue chart data - use real monthly revenue data
            if (analytics?.MonthlyRevenueData != null && analytics.MonthlyRevenueData.Any())
            {
                var revenueLabels = analytics.MonthlyRevenueData.Select(r => r.Month).ToArray();
                var revenueData = analytics.MonthlyRevenueData.Select(r => (int)r.Revenue).ToArray();

                Console.WriteLine($"Initializing revenue chart with {revenueLabels.Length} months of real data");
                await JSRuntime.InvokeVoidAsync("initializeLineChart", "revenueChart", revenueLabels, revenueData);
            }
            else
            {
                Console.WriteLine("No monthly revenue data available, chart will not be displayed");
            }

            // Initialize User Growth Chart
            if (analytics?.UserRegistrations != null && analytics.UserRegistrations.Any())
            {
                var userGrowthLabels = analytics.UserRegistrations.Take(12).Select(u => u.Month).ToArray();
                var userGrowthData = analytics.UserRegistrations.Take(12).Select(u => u.Count).ToArray();
                
                Console.WriteLine($"Initializing user growth chart with {userGrowthLabels.Length} months");
                await JSRuntime.InvokeVoidAsync("initializeUserGrowthChart", "userGrowthChart", userGrowthLabels, userGrowthData);
            }

            // Initialize Revenue vs Listings Comparison Chart
            if (analytics?.MonthlyRevenueData != null && analytics.MonthlyRevenueData.Any() && 
                analytics?.PopularBrands != null && analytics.PopularBrands.Any())
            {
                var comparisonLabels = analytics.MonthlyRevenueData.Select(r => r.Month).ToArray();
                var comparisonRevenueData = analytics.MonthlyRevenueData.Select(r => (int)r.Revenue).ToArray();
                
                // Simulate listings data based on brands (or could be actual monthly listings if available)
                var totalListings = analytics.PopularBrands.Sum(b => b.Count);
                var avgListingsPerMonth = totalListings / 12;
                var comparisonListingsData = Enumerable.Range(0, comparisonLabels.Length)
                    .Select(i => avgListingsPerMonth + new Random(i).Next(-5, 15))
                    .ToArray();
                
                Console.WriteLine($"Initializing comparison chart");
                await JSRuntime.InvokeVoidAsync("initializeComparisonChart", "comparisonChart", comparisonLabels, comparisonRevenueData, comparisonListingsData);
            }

            // Initialize Revenue Per Brand Chart
            if (analytics?.PopularBrands != null && analytics.PopularBrands.Any() && analytics.TotalRevenue > 0)
            {
                var topBrands = analytics.PopularBrands.OrderByDescending(b => b.Count).Take(8).ToList();
                var brandLabels = topBrands.Select(b => b.Brand).ToArray();
                
                // Calculate estimated average revenue per listing for each brand
                var totalListings = analytics.PopularBrands.Sum(b => b.Count);
                var avgRevenuePerListing = totalListings > 0 ? analytics.TotalRevenue / totalListings : 0;
                var brandRevenueData = topBrands.Select(b => (int)(avgRevenuePerListing * b.Count / b.Count)).ToArray();
                
                Console.WriteLine($"Initializing revenue per brand chart with {brandLabels.Length} brands");
                await JSRuntime.InvokeVoidAsync("initializeRevenuePerBrandChart", "revenuePerBrandChart", brandLabels, brandRevenueData);
            }

            // Initialize Category Performance Radar Chart
            if (analytics?.ListingsByCategory != null && analytics.ListingsByCategory.Any())
            {
                var topCategories = analytics.ListingsByCategory.OrderByDescending(c => c.Count).Take(6).ToList();
                var categoryLabels = topCategories.Select(c => c.Category).ToArray();
                
                // Normalize the data to 0-100 scale for better radar visualization
                var maxCount = topCategories.Max(c => c.Count);
                var categoryPerformanceData = topCategories.Select(c => (int)((c.Count * 100.0) / maxCount)).ToArray();
                
                Console.WriteLine($"Initializing category radar chart with {categoryLabels.Length} categories");
                await JSRuntime.InvokeVoidAsync("initializeCategoryRadarChart", "categoryRadarChart", categoryLabels, categoryPerformanceData);
            }
            
            Console.WriteLine("All charts initialized successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing charts: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }
}