@page "/buyer-dashboard"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize(Roles = "Buyer,Seller,Admin,Manager")]
@inject IOrderService OrderService
@inject IAuthService AuthService
@inject IWishlistService WishlistService
@inject NavigationManager NavManager

<div class="container-fluid py-4 bg-light min-vh-100">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1"><i class="fa fa-shopping-bag me-2 text-primary"></i>My Dashboard</h1>
                    <p class="text-muted">Welcome back, @buyerName 👋</p>
                </div>
                <button class="btn btn-success btn-lg" @onclick='() => NavManager.NavigateTo("/shop")'>
                    <i class="fa fa-search me-2"></i>Browse Cars
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted">Loading your dashboard data...</p>
        </div>
    }
    else
    {
        <!-- Quick Stats Row -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Total Orders</p>
                                <h3 class="mb-0 text-primary">@totalOrders</h3>
                            </div>
                            <div class="stat-icon bg-primary bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-shopping-cart fa-2x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Active Orders</p>
                                <h3 class="mb-0 text-warning">@activeOrders</h3>
                            </div>
                            <div class="stat-icon bg-warning bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-hourglass-half fa-2x text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Wishlist Items</p>
                                <h3 class="mb-0 text-success">@wishlistCount</h3>
                            </div>
                            <div class="stat-icon bg-success bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-heart fa-2x text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card shadow-sm border-0 h-100 stat-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted small mb-1">Total Spent</p>
                                <h3 class="mb-0 text-danger">@totalSpent.ToString("N0") TND</h3>
                            </div>
                            <div class="stat-icon bg-danger bg-opacity-10 rounded-circle p-3">
                                <i class="fa fa-money-bill-wave fa-2x text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Row -->
        <div class="row">
            <!-- Left Column: Recent Orders -->
            <div class="col-lg-8 mb-4">
                <!-- Recent Orders -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0"><i class="fa fa-shopping-bag me-2 text-primary"></i>Recent Orders</h5>
                        <a href="/my-orders" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        @if (orders != null && orders.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Order ID</th>
                                            <th>Car</th>
                                            <th>Price</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in orders.Take(5))
                                        {
                                            <tr>
                                                <td>
                                                    <small class="fw-semibold">#@order.Id</small>
                                                </td>
                                                <td>
                                                    <small>@(order.Items?.FirstOrDefault()?.ProductName ?? "Unknown")</small>
                                                </td>
                                                <td>
                                                    <small class="fw-semibold">@order.TotalAmount.ToString("N0") TND</small>
                                                </td>
                                                <td>
                                                    @if (order.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success">Completed</span>
                                                    }
                                                    else if (order.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                    else if (order.Status == "Cancelled")
                                                    {
                                                        <span class="badge bg-danger">Cancelled</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info">@order.Status</span>
                                                    }
                                                </td>
                                                <td>
                                                    <small>@order.OrderDate.ToString("MMM dd, yyyy")</small>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewOrderDetails(order.Id)">
                                                        <i class="fa fa-eye"></i> View
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No orders yet. Start shopping for your perfect car!</p>
                                <button class="btn btn-primary" @onclick='() => NavManager.NavigateTo("/shop")'>
                                    <i class="fa fa-search me-2"></i>Browse Cars
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Wishlist Preview -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0"><i class="fa fa-heart me-2 text-danger"></i>Wishlist Preview</h5>
                        <a href="/wishlist" class="btn btn-sm btn-outline-primary">View All</a>
                    </div>
                    <div class="card-body">
                        @if (wishlistItems != null && wishlistItems.Count > 0)
                        {
                            <div class="row">
                                @foreach (var item in wishlistItems.Take(3))
                                {
                                    @if (item.CarListing != null)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="listing-card border rounded-3 overflow-hidden h-100 transition">
                                                <div class="position-relative">
                                                    <img src="@GetImageUrl(item.CarListing.Image)" class="img-fluid" alt="@item.CarListing.Name"
                                                         style="height: 180px; width: 100%; object-fit: cover;">
                                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                                        <i class="fa fa-heart"></i> Saved
                                                    </span>
                                                </div>
                                                <div class="p-3">
                                                    <h6 class="mb-1 text-truncate">@item.CarListing.Name</h6>
                                                    <p class="text-primary fw-bold mb-2">@item.CarListing.Price.ToString("N0") TND</p>
                                                    <div class="small text-muted mb-2">
                                                        <div><i class="fa fa-calendar me-1"></i>@item.CarListing.Year</div>
                                                        <div><i class="fa fa-tachometer-alt me-1"></i>@item.CarListing.Mileage.ToString("N0") km</div>
                                                    </div>
                                                    <div class="d-grid gap-2">
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewCarDetails(item.CarListing.ProductId)">
                                                            <i class="fa fa-eye me-1"></i>View Details
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fa fa-heart fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No items in your wishlist yet</p>
                                <button class="btn btn-primary" @onclick='() => NavManager.NavigateTo("/shop")'>
                                    <i class="fa fa-search me-2"></i>Find Cars
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Stats & Quick Actions -->
            <div class="col-lg-4">
                <!-- Activity Summary -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 py-3">
                        <h5 class="mb-0"><i class="fa fa-chart-line me-2 text-info"></i>Activity Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="performance-metric mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small">Completion Rate</span>
                                <span class="badge bg-success">@completionRate.ToString("F0")%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: @completionRate%"></div>
                            </div>
                        </div>

                        <div class="performance-metric">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small">Average Order Value</span>
                                <span class="fw-semibold">@averageOrderValue.ToString("N0") TND</span>
                            </div>
                            <p class="text-muted small mb-0">From @totalOrders total orders</p>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions Card -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom-0 py-3">
                        <h5 class="mb-0"><i class="fa fa-bolt me-2 text-warning"></i>Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" @onclick='() => NavManager.NavigateTo("/shop")'>
                                <i class="fa fa-search me-2"></i>Browse Cars
                            </button>
                            <button class="btn btn-outline-success" @onclick='() => NavManager.NavigateTo("/my-orders")'>
                                <i class="fa fa-shopping-bag me-2"></i>My Orders
                            </button>
                            <button class="btn btn-outline-danger" @onclick='() => NavManager.NavigateTo("/wishlist")'>
                                <i class="fa fa-heart me-2"></i>My Wishlist
                            </button>
                            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/profile")'>
                                <i class="fa fa-user me-2"></i>My Profile
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Help & Support -->
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body text-center py-4">
                        <i class="fa fa-question-circle fa-2x text-muted mb-3"></i>
                        <h6 class="mb-2">Need Help?</h6>
                        <p class="small text-muted mb-3">Check our buyer guide for tips on finding and purchasing cars.</p>
                        <a href="#" class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-book me-1"></i>Buyer Guide
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .stat-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }

    .stat-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 80px;
        height: 80px;
    }

    .listing-card {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .listing-card:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        transform: translateY(-3px);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(0,0,0,0.02);
    }

    .performance-metric {
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .performance-metric:last-child {
        border-bottom: none;
    }

    .transition {
        transition: all 0.3s ease;
    }
</style>

@code {
    private List<OrderDto> orders = new();
    private List<WishlistDto> wishlistItems = new();
    private bool isLoading = true;
    private string currentUserId;
    private string buyerName = "Buyer";
    
    // Statistics
    private int totalOrders = 0;
    private int activeOrders = 0;
    private int wishlistCount = 0;
    private decimal totalSpent = 0;
    private decimal averageOrderValue = 0;
    private double completionRate = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null)
            {
                NavManager.NavigateTo("/login");
                return;
            }

            currentUserId = user.Id;
            buyerName = user.Profile?.FirstName ?? user.UserName ?? "Buyer";

            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Load orders
            var ordersResult = await OrderService.GetUserOrdersAsync(1, 100);
            orders = ordersResult?.Data ?? new List<OrderDto>();
            
            // Calculate order stats
            totalOrders = orders?.Count ?? 0;
            activeOrders = orders?.Count(o => o.Status != "Completed" && o.Status != "Cancelled") ?? 0;
            
            if (orders != null && orders.Count > 0)
            {
                totalSpent = orders.Sum(o => o.TotalAmount);
                averageOrderValue = totalSpent / totalOrders;
                
                var completedCount = orders.Count(o => o.Status == "Completed");
                completionRate = (double)completedCount / totalOrders * 100;
            }

            // Load wishlist items
            wishlistItems = await WishlistService.GetMyWishlistAsync();
            wishlistCount = wishlistItems?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    private string GetImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
        {
            return "/images/noimage.jpg";
        }
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
        {
            return imagePath;
        }
        var apiBaseUrl = "http://localhost:5237";
        if (imagePath.StartsWith("/"))
        {
            return $"{apiBaseUrl}{imagePath}";
        }
        return $"{apiBaseUrl}/images/{imagePath}";
    }

    private void ViewOrderDetails(int orderId)
    {
        NavManager.NavigateTo($"/my-orders/{orderId}");
    }

    private void ViewCarDetails(int productId)
    {
        NavManager.NavigateTo($"/product/{productId}");
    }
}
