@page "/confirm-email"
@using BlazorApp.Services
@using BlazorApp.Models
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Email Confirmation - Tunisia Motors</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0"><i class="fa fa-check-circle me-2"></i>Email Confirmation</h4>
                </div>
                <div class="card-body p-4 text-center">
                    @if (isLoading)
                    {
                        <div class="mb-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Confirming your email...</p>
                        </div>
                    }
                    else if (isSuccess)
                    {
                        <div class="mb-4">
                            <i class="fa fa-check-circle fa-4x text-success mb-3"></i>
                            <h5 class="text-success">Email Confirmed Successfully!</h5>
                            <p class="text-muted">Your email has been verified. You can now sign in to your account.</p>
                        </div>
                        <a href="/login" class="btn btn-primary">
                            <i class="fa fa-sign-in-alt me-2"></i>Sign In
                        </a>
                    }
                    else
                    {
                        <div class="mb-4">
                            <i class="fa fa-exclamation-triangle fa-4x text-warning mb-3"></i>
                            <h5 class="text-warning">Confirmation Failed</h5>
                            <p class="text-muted">@errorMessage</p>
                        </div>
                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-outline-primary" @onclick="ResendConfirmation">
                                <i class="fa fa-envelope me-2"></i>Resend Email
                            </button>
                            <a href="/login" class="btn btn-secondary">
                                <i class="fa fa-arrow-left me-2"></i>Back to Login
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string UserId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string Token { get; set; }

    private bool isLoading = true;
    private bool isSuccess = false;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(UserId) && !string.IsNullOrEmpty(Token))
        {
            await ProcessEmailConfirmation();
        }
        else
        {
            isLoading = false;
            errorMessage = "Invalid confirmation link. Please check your email for the correct link.";
        }
    }

    private async Task ProcessEmailConfirmation()
    {
        try
        {
            // Call the API to confirm email
            var response = await AuthService.ConfirmEmailAsync(UserId, Token);
            if (response.Success)
            {
                isSuccess = true;
            }
            else
            {
                errorMessage = response.Message ?? "Email confirmation failed. The link may be expired or invalid.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while confirming your email. Please try again.";
            Console.WriteLine($"Email confirmation error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResendConfirmation()
    {
        // Navigate to resend verification page
        NavigationManager.NavigateTo("/resend-verification");
    }
}