@page "/login"
@using BlazorApp.Services
@using BlazorApp.Models
@inject IAuthService AuthService
@inject NavigationManager NavManager

<div class="container-fluid bg-light py-5 min-vh-100">
    <div class="row justify-content-center align-items-center">
        <div class="col-lg-5 col-md-7 col-12">
            <!-- Login Card -->
            <div class="card shadow-lg border-0 rounded-4">
                <!-- Header with Logo/Icon -->
                <div class="card-header bg-primary text-white border-0 rounded-top-4 py-4">
                    <div class="text-center">
                        <i class="fa fa-sign-in-alt fa-2x mb-2"></i>
                        <h3 class="mb-1">Welcome Back</h3>
                        <p class="mb-0 small">Sign in to your account</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fa fa-exclamation-circle me-2"></i>@errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }

                    <form @onsubmit="HandleLogin">
                        <!-- Email Field -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-envelope me-1 text-primary"></i>Email Address
                            </label>
                            <input type="email" class="form-control form-control-lg" 
                                   placeholder="your@email.com" @bind="loginModel.Email" required />
                        </div>

                        <!-- Password Field with Toggle -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fa fa-lock me-1 text-primary"></i>Password
                            </label>
                            <div class="input-group input-group-lg">
                                <input type="@(showPassword ? "text" : "password")" 
                                       class="form-control" 
                                       placeholder="Enter your password"
                                       @bind="loginModel.Password" required />
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => showPassword = !showPassword">
                                    <i class="fa fa-@(showPassword ? "eye-slash" : "eye")"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" @bind="rememberMe" />
                                    <label class="form-check-label" for="rememberMe">
                                        Remember me
                                    </label>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <a href="/forgot-password" class="text-primary small text-decoration-none">Forgot password?</a>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Signing in...</span>
                            }
                            else
                            {
                                <i class="fa fa-sign-in-alt me-2"></i>
                                <span>Sign In</span>
                            }
                        </button>
                    </form>

                    <!-- Additional Links -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="text-center mb-3">
                            <p class="mb-2 text-muted small">
                                <a href="/resend-verification" class="text-primary text-decoration-none">
                                    <i class="fa fa-envelope me-1"></i>Didn't receive verification email?
                                </a>
                            </p>
                        </div>
                        <p class="mb-0 text-center text-muted">
                            Don't have an account? 
                            <a href="/register" class="text-primary fw-semibold text-decoration-none">Create one here</a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Footer Info -->
            <div class="text-center mt-3 text-muted small">
                <p>Need help? <a href="#" class="text-primary text-decoration-none">Contact Support</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;
    private bool rememberMe = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            var result = await AuthService.LoginAsync(loginModel);
            if (result.Success)
            {
                // Small delay to allow authentication state to propagate
                await Task.Delay(100);
                NavManager.NavigateTo("/");
            }
            else
            {
                errorMessage = result.Message ?? "Login failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
