@page "/access-denied"
<PageTitle>Access Denied - Tunisia Motors</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="text-center">
                <div class="mb-4">
                    <i class="fa fa-shield-alt fa-5x text-danger"></i>
                </div>
                <h1 class="display-4 text-danger mb-3">Access Denied</h1>
                <p class="lead text-muted mb-4">
                    You don't have permission to access this page. Please contact an administrator if you believe this is an error.
                </p>

                <div class="card shadow mb-4">
                    <div class="card-body">
                        <h5 class="card-title">What you can do:</h5>
                        <ul class="list-unstyled text-start">
                            <li class="mb-2"><i class="fa fa-home me-2 text-primary"></i>Go back to the homepage</li>
                            <li class="mb-2"><i class="fa fa-sign-in-alt me-2 text-primary"></i>Try logging in with different credentials</li>
                            <li class="mb-2"><i class="fa fa-envelope me-2 text-primary"></i>Contact support for assistance</li>
                        </ul>
                    </div>
                </div>

                <div class="btn-group" role="group">
                    <a href="/" class="btn btn-primary">
                        <i class="fa fa-home me-2"></i>Go Home
                    </a>
                    <a href="/login" class="btn btn-outline-primary">
                        <i class="fa fa-sign-in-alt me-2"></i>Sign In
                    </a>
                    <a href="mailto:contact@carecommerce.tn" class="btn btn-outline-secondary">
                        <i class="fa fa-envelope me-2"></i>Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>