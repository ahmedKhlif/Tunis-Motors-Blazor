@page "/forgot-password-confirmation"
<PageTitle>Check Your Email - Tunisia Motors</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-center">
                <div class="mb-4">
                    <i class="fa fa-envelope fa-5x text-primary"></i>
                </div>
                <h1 class="display-5 text-primary mb-3">Check Your Email</h1>
                <p class="lead text-muted mb-4">
                    We've sent password reset instructions to your email address.
                </p>

                <div class="card shadow mb-4">
                    <div class="card-body">
                        <h5 class="card-title">What happens next?</h5>
                        <ul class="list-unstyled text-start">
                            <li class="mb-2"><i class="fa fa-envelope-open me-2 text-primary"></i>Check your email inbox (and spam folder)</li>
                            <li class="mb-2"><i class="fa fa-link me-2 text-primary"></i>Click the password reset link in the email</li>
                            <li class="mb-2"><i class="fa fa-key me-2 text-primary"></i>Create a new password</li>
                            <li class="mb-2"><i class="fa fa-sign-in-alt me-2 text-primary"></i>Sign in with your new password</li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"></i>
                    <strong>Note:</strong> The reset link will expire in 24 hours for security reasons.
                </div>

                <div class="btn-group" role="group">
                    <a href="/login" class="btn btn-primary">
                        <i class="fa fa-sign-in-alt me-2"></i>Back to Sign In
                    </a>
                    <button class="btn btn-outline-secondary" @onclick="ResendEmail">
                        <i class="fa fa-envelope me-2"></i>Resend Email
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Alert Dialog -->
<AlertDialog IsVisible="@showAlert"
             Title="@alertTitle"
             Message="@alertMessage"
             Type="@alertType"
             OnClose="@CloseAlert" />

@code {
    private bool showAlert = false;
    private string alertTitle = "";
    private string alertMessage = "";
    private AlertDialog.AlertType alertType = AlertDialog.AlertType.Info;

    private async Task ResendEmail()
    {
        var email = await JSRuntime.InvokeAsync<string>("prompt", "Enter your email address:");
        if (!string.IsNullOrWhiteSpace(email))
        {
            alertTitle = "Email Sent";
            alertMessage = "If an account with that email exists, a new reset link has been sent.";
            alertType = AlertDialog.AlertType.Info;
            showAlert = true;
        }
    }

    private void CloseAlert()
    {
        showAlert = false;
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}