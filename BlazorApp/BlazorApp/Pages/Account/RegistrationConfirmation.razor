@page "/registration-confirmation"
<PageTitle>Registration Successful - Tunisia Motors</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-center">
                <div class="mb-4">
                    <i class="fa fa-check-circle fa-5x text-success"></i>
                </div>
                <h1 class="display-5 text-success mb-3">Registration Successful!</h1>
                <p class="lead text-muted mb-4">
                    Welcome to Tunisia Motors! Your account has been created successfully.
                </p>

                <div class="card shadow mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Next Steps</h5>
                        <ul class="list-unstyled text-start">
                            <li class="mb-2"><i class="fa fa-envelope me-2 text-primary"></i>Check your email for account verification</li>
                            <li class="mb-2"><i class="fa fa-link me-2 text-primary"></i>Click the verification link in the email</li>
                            <li class="mb-2"><i class="fa fa-sign-in-alt me-2 text-primary"></i>Sign in to start buying or selling cars</li>
                            <li class="mb-2"><i class="fa fa-user-edit me-2 text-primary"></i>Complete your profile information</li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fa fa-info-circle me-2"></i>
                    <strong>Important:</strong> You must verify your email address before you can sign in.
                </div>

                <div class="btn-group" role="group">
                    <a href="/login" class="btn btn-primary">
                        <i class="fa fa-sign-in-alt me-2"></i>Sign In Now
                    </a>
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="fa fa-home me-2"></i>Browse Cars
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>