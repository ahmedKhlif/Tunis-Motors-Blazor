@page "/forgot-password"
@using BlazorApp.Services
@using BlazorApp.Models
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Forgot Password - Tunisia Motors</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0"><i class="fa fa-key me-2"></i>Forgot Password</h4>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                        </div>
                    }

                    <p class="text-muted mb-4">
                        Enter your email address and we'll send you a link to reset your password.
                    </p>

                    <EditForm Model="forgotPasswordModel" OnValidSubmit="HandleForgotPassword" FormName="forgotPasswordForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <InputText id="email" class="form-control" @bind-Value="forgotPasswordModel.Email" placeholder="Enter your email" />
                            <ValidationMessage For="() => forgotPasswordModel.Email" class="text-danger" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <text><span class="spinner-border spinner-border-sm me-2" role="status"></span>Sending...</text>
                                }
                                else
                                {
                                    <text><i class="fa fa-paper-plane me-2"></i>Send Reset Link</text>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <div class="text-center mt-4">
                        <p class="mb-0">
                            Remember your password?
                            <a href="/login" class="text-decoration-none">Sign in here</a>
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="btn btn-outline-secondary">
                    <i class="fa fa-home me-2"></i>Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private string successMessage = "";
    private string errorMessage = "";
    private bool isSubmitting = false;

    private async Task HandleForgotPassword()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var result = await AuthService.ForgotPasswordAsync(forgotPasswordModel.Email);
            if (result.Success)
            {
                successMessage = "If an account with that email exists, we have sent a password reset link.";
                forgotPasswordModel.Email = "";
            }
            else
            {
                errorMessage = result.Message ?? "An error occurred while processing your request.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Forgot password error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = "";
    }
}