@page "/shop"
@using BlazorApp.Services
@using BlazorApp.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ICarListingService CarListingService
@inject ICategoryService CategoryService
@inject IWishlistService WishlistService
@inject ICartService CartService
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject ICompareService CompareService

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Car Listings</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li class="active">Browse Cars</li>
                </ul>
            </div>
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- Success/Error Messages -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        <!-- row -->
        <div class="row">
            <!-- ASIDE -->
            <div id="aside" class="col-md-3">
                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Categories</h3>
                    <div class="checkbox-filter">
                        @if (categories != null && categories.Any())
                        {
                            @foreach (var category in categories)
                            {
                                <div class="input-checkbox">
                                    <input type="checkbox" id="category-@category.CategoryId" name="category-filter" value="@category.CategoryId" @onchange="() => ToggleCategory(category.CategoryId)">
                                    <label for="category-@category.CategoryId">
                                        <span></span>
                                        @category.CategoryName
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Price Range</h3>
                    <div class="price-filter">
                        <div id="price-slider"></div>
                        <div class="input-number price-min">
                            <input id="price-min" type="number" @bind="filterModel.MinPrice" placeholder="Min Price">
                            <span class="qty-up" @onclick="IncreasePriceMin">+</span>
                            <span class="qty-down" @onclick="DecreasePriceMin">-</span>
                        </div>
                        <span>-</span>
                        <div class="input-number price-max">
                            <input id="price-max" type="number" @bind="filterModel.MaxPrice" placeholder="Max Price">
                            <span class="qty-up" @onclick="IncreasePriceMax">+</span>
                            <span class="qty-down" @onclick="DecreasePriceMax">-</span>
                        </div>
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Year Range</h3>
                    <div class="mb-2">
                        <label for="year-min" class="form-label small">From Year</label>
                        <div class="input-number year-min">
                            <input id="year-min" type="number" @bind="filterModel.MinYear" placeholder="e.g. 2010" min="1900" max="2025">
                            <span class="qty-up" @onclick="IncreaseYearMin">+</span>
                            <span class="qty-down" @onclick="DecreaseYearMin">-</span>
                        </div>
                    </div>
                    <div>
                        <label for="year-max" class="form-label small">To Year</label>
                        <div class="input-number year-max">
                            <input id="year-max" type="number" @bind="filterModel.MaxYear" placeholder="e.g. 2024" min="1900" max="2025">
                            <span class="qty-up" @onclick="IncreaseYearMax">+</span>
                            <span class="qty-down" @onclick="DecreaseYearMax">-</span>
                        </div>
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Mileage</h3>
                    <div>
                        <label for="mileage-max" class="form-label small">Max Mileage (km)</label>
                        <div class="input-number mileage-max">
                            <input id="mileage-max" type="number" @bind="filterModel.MaxMileage" placeholder="e.g. 100000" min="0" max="1000000">
                            <span class="qty-up" @onclick="IncreaseMileage">+</span>
                            <span class="qty-down" @onclick="DecreaseMileage">-</span>
                        </div>
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Fuel Type</h3>
                    <select id="fuel-type" @bind="filterModel.FuelType" class="form-select">
                        <option value="">All Fuel Types</option>
                        @if (fuelTypes != null)
                        {
                            @foreach (var fuel in fuelTypes)
                            {
                                <option value="@fuel">@fuel</option>
                            }
                        }
                    </select>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Transmission</h3>
                    <select id="transmission" @bind="filterModel.Transmission" class="form-select">
                        <option value="">All Transmissions</option>
                        @if (transmissions != null)
                        {
                            @foreach (var trans in transmissions)
                            {
                                <option value="@trans">@trans</option>
                            }
                        }
                    </select>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Color</h3>
                    <div class="color-filter">
                        @if (colors != null)
                        {
                            @foreach (var col in colors)
                            {
                                <div class="color-option">
                                    <input type="radio" id="color-@col.Replace("#", "").Replace(" ", "")" name="color-filter" value="@col" @onchange="() => SetColor(col)">
                                    <label for="color-@col.Replace("#", "").Replace(" ", "")" style="background-color: @col;" title="@col"></label>
                                </div>
                            }
                        }
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Minimum Rating</h3>
                    <div class="rating-filter">
                        <div class="rating-option">
                            <input type="radio" id="rating-all" name="rating-filter" value="" @onchange="() => SetMinRating(null)" checked="@(filterModel.MinRating == null)">
                            <label for="rating-all">All Ratings</label>
                        </div>
                        @for (int i = 4; i >= 1; i--)
                        {
                            <div class="rating-option">
                                <input type="radio" id="rating-@i" name="rating-filter" value="@i" @onchange="() => SetMinRating(i)" checked="@(filterModel.MinRating == i)">
                                <label for="rating-@i">
                                    @for (int j = 1; j <= 5; j++)
                                    {
                                        if (j <= i)
                                        {
                                            <i class="fa fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-star-o"></i>
                                        }
                                    }
                                    <span>& Up</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Brands</h3>
                    <div class="checkbox-filter">
                        @if (brands != null)
                        {
                            @foreach (var brand in brands)
                            {
                                <div class="input-checkbox">
                                    <input type="checkbox" id="brand-@brand" name="brand-filter" value="@brand" @onchange="() => ToggleBrand(brand)">
                                    <label for="brand-@brand">
                                        <span></span>
                                        @brand
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>
                <!-- /aside Widget -->

                <!-- aside Widget -->
                <div class="aside">
                    <button id="apply-filters-btn" class="primary-btn" @onclick="ApplyFilters">Apply Filters</button>
                    <button id="clear-filters-btn" class="primary-btn" style="background: #ccc; color: #000;" @onclick="ClearFilters">Clear Filters</button>
                </div>
                <!-- /aside Widget -->
            </div>
            <!-- /ASIDE -->

            <!-- STORE -->
            <div id="store" class="col-md-9">
                <!-- store top filter -->
                <div class="store-filter clearfix">
                    <div class="store-sort">
                        <label>
                            Sort By:
                            <select class="input-select" @bind="filterModel.SortBy" @bind:after="ApplyFilters">
                                <option value="0">Newest</option>
                                <option value="1">Price: Low to High</option>
                                <option value="2">Price: High to Low</option>
                                <option value="3">Oldest</option>
                            </select>
                        </label>
                    </div>
                    <ul class="store-grid">
                        <li class="active" @onclick="SetViewModeGrid"><i class="fa fa-th"></i></li>
                        <li @onclick="SetViewModeList"><i class="fa fa-th-list"></i></li>
                    </ul>
                </div>
                <!-- /store top filter -->

                <!-- store products -->
                <div class="row">
                    @if (isLoading)
                    {
                        <div class="col-md-12 text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading cars...</p>
                        </div>
                    }
                    else if (cars != null && cars.Data.Any())
                    {
                        @foreach (var car in cars.Data)
                        {
                            <!-- product -->
                            <div class="col-md-4 col-xs-6 product-item">
                                <div class="product">
                                    <div class="product-img">
                                        <img src="@GetImageUrl(car.Image)" alt="@car.Name" onerror="this.src='./images/noimage.jpg'">
                                        <div class="product-label">
                                            @if (car.Condition == "New")
                                            {
                                                <span class="new">NEW</span>
                                            }
                                            else
                                            {
                                                <span class="sale">USED</span>
                                            }
                                            @if (!car.IsApproved)
                                            {
                                                <span class="sale">PENDING</span>
                                            }
                                            @if (car.IsAvailableForRental)
                                            {
                                                <span class="rent">RENTAL</span>
                                            }
                                            @if (car.QuantityInStock == 0)
                                            {
                                                <span class="out">SOLD OUT</span>
                                            }
                                            else if (car.QuantityInStock <= 2)
                                            {
                                                <span class="sale">ONLY @car.QuantityInStock LEFT</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="product-body">
                                        <p class="product-category d-flex align-items-center">
                                            @car.Category?.CategoryName
                                            <span style="width: 12px; height: 12px; background-color: @car.Color; border: 1px solid #ccc; border-radius: 50%; margin-left: 8px;" title="@car.Color"></span>
                                        </p>
                                        <h3 class="product-name"><a href="/product/@car.ProductId">@car.Name (@car.Year)</a></h3>
                                        <h4 class="product-price">@car.Price.ToString("N0") TND</h4>
                                        <div class="product-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= car.Rating)
                                                {
                                                    <i class="fa fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-star-o"></i>
                                                }
                                            }
                                        </div>
                                        <div class="product-btns">
                                            <button class="add-to-wishlist" @onclick="() => ToggleWishlist(car.ProductId)">
                                                <i class="fa-regular fa-heart"></i><span class="tooltipp">add to wishlist</span>
                                            </button>
                                            <button class="add-to-compare @(compareStatus.ContainsKey(car.Id) && compareStatus[car.Id] ? "active" : "")" 
                                                    @onclick="() => ToggleCompare(car)" 
                                                    title="@(compareStatus.ContainsKey(car.Id) && compareStatus[car.Id] ? "Remove from compare" : "Add to compare")">
                                                <i class="fa @(compareStatus.ContainsKey(car.Id) && compareStatus[car.Id] ? "fa-check" : "fa-exchange")"></i>
                                                <span class="tooltipp">@(compareStatus.ContainsKey(car.Id) && compareStatus[car.Id] ? "in compare" : "add to compare")</span>
                                            </button>
                                            <button class="quick-view" @onclick="() => QuickView(car.ProductId)">
                                                <i class="fa fa-eye"></i><span class="tooltipp">quick view</span>
                                            </button>
                                            @if (isAdminOrManager || (currentUserId == car.SellerId))
                                            {
                                                <button class="quick-edit" @onclick="() => EditCar(car.ProductId)">
                                                    <i class="fa fa-edit"></i><span class="tooltipp">edit</span>
                                                </button>
                                                <button class="quick-delete" @onclick="() => DeleteCar(car.ProductId)">
                                                    <i class="fa fa-trash"></i><span class="tooltipp">delete</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="add-to-cart">
                                        @if (isAuthenticated)
                                        {
                                            @if (car.QuantityInStock > 0)
                                            {
                                                <button class="add-to-cart-btn" @onclick="() => AddToCart(car.ProductId)">
                                                    <i class="fa fa-shopping-cart"></i> add to cart
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="add-to-cart-btn disabled" disabled>
                                                    <i class="fa fa-times-circle"></i> sold out
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <a href="/login" class="add-to-cart-btn">
                                                <i class="fa fa-sign-in"></i> login to buy
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <!-- /product -->
                        }
                    }
                    else
                    {
                        <div class="col-md-12">
                            <div class="text-center py-5">
                                <i class="fa fa-car fa-3x text-muted mb-3"></i>
                                <h4 class="text-muted">No cars found</h4>
                                <p class="text-muted">Try adjusting your search criteria or browse all listings.</p>
                                <button class="primary-btn" @onclick="ClearFilters">View All Cars</button>
                            </div>
                        </div>
                    }
                </div>
                <!-- /store products -->

                <!-- store bottom filter -->
                @if (cars != null && cars.TotalPages > 1)
                {
                    <div class="store-filter clearfix">
                        <span class="store-qty">Showing page @cars.PageNumber of @cars.TotalPages</span>
                        <ul class="store-pagination">
                            @for (int i = 1; i <= cars.TotalPages; i++)
                            {
                                <li class="@(i == cars.PageNumber ? "active" : "")">
                                    <a href="#" @onclick="() => GoToPage(i)">@i</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <!-- /store bottom filter -->
            </div>
            <!-- /STORE -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /SECTION -->

@code {
    private PaginatedDto<CarListingDto> cars;
    private List<CategoryDto> categories;
    private List<string> brands;
    private List<string> fuelTypes;
    private List<string> transmissions;
    private List<string> colors;
    private CarListingFilterDto filterModel = new();
    private bool isLoading = true;
    private string successMessage = "";
    private string errorMessage = "";
    private bool isAuthenticated = false;
    private bool isAdminOrManager = false;
    private string currentUserId = "";
    private List<int> selectedCategories = new();
    private List<string> selectedBrands = new();
    private Dictionary<int, bool> compareStatus = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFilters();
        await CheckAuthentication();
        await ApplyFilters();
        await LoadCompareStatus();
    }

    private async Task LoadCompareStatus()
    {
        if (cars?.Data != null)
        {
            foreach (var car in cars.Data)
            {
                try
                {
                    compareStatus[car.Id] = await CompareService.IsInCompareAsync(car.Id);
                }
                catch
                {
                    compareStatus[car.Id] = false;
                }
            }
        }
    }

    private async Task LoadFilters()
    {
        try
        {
            categories = await CategoryService.GetAllCategoriesAsync();
            brands = await CarListingService.GetBrandsAsync();
            fuelTypes = await CarListingService.GetFuelTypesAsync();
            transmissions = await CarListingService.GetTransmissionsAsync();
            colors = await CarListingService.GetColorsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load filter options.";
            Console.WriteLine($"Load filters error: {ex.Message}");
        }
    }

    private async Task CheckAuthentication()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

            if (isAuthenticated)
            {
                var user = await AuthService.GetCurrentUserAsync();
                currentUserId = user?.Id ?? "";
                var roles = user?.Roles ?? new List<string>();
                isAdminOrManager = roles.Contains("Admin") || roles.Contains("Manager");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth check error: {ex.Message}");
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            // Apply all selected filters
            filterModel.CategoryId = selectedCategories.Any() ? selectedCategories.First() : null;
            filterModel.Brand = selectedBrands.Any() ? selectedBrands.First() : null;
            
            Console.WriteLine($"Applying filters - Category: {filterModel.CategoryId}, Brand: {filterModel.Brand}, Fuel: {filterModel.FuelType}, Transmission: {filterModel.Transmission}, Color: {filterModel.Color}, MinPrice: {filterModel.MinPrice}, MaxPrice: {filterModel.MaxPrice}");

            cars = await CarListingService.GetAllListingsAsync(filterModel);
            
            Console.WriteLine($"Loaded {cars?.Data?.Count ?? 0} cars after filtering");
            await LoadCompareStatus(); // Reload compare status for new cars
            StateHasChanged(); // Force UI update
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load cars.";
            Console.WriteLine($"Apply filters error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearFilters()
    {
        filterModel = new CarListingFilterDto();
        selectedCategories.Clear();
        selectedBrands.Clear();
        filterModel.MinRating = null;
        Console.WriteLine("Filters cleared, reloading all cars...");
        await ApplyFilters();
    }

    private void ToggleCategory(int categoryId)
    {
        if (selectedCategories.Contains(categoryId))
        {
            selectedCategories.Remove(categoryId);
        }
        else
        {
            selectedCategories.Clear(); // Single selection for simplicity
            selectedCategories.Add(categoryId);
        }
    }

    private void ToggleBrand(string brand)
    {
        if (selectedBrands.Contains(brand))
        {
            selectedBrands.Remove(brand);
        }
        else
        {
            selectedBrands.Clear(); // Single selection for simplicity
            selectedBrands.Add(brand);
        }
    }

    private void SetColor(string color)
    {
        filterModel.Color = color;
    }

    private void SetMinRating(int? rating)
    {
        filterModel.MinRating = rating;
    }

    private async Task GoToPage(int page)
    {
        filterModel.Page = page;
        await ApplyFilters();
    }

    private void SetViewModeGrid()
    {
        // In a full implementation, this would toggle CSS classes
        // For now, just keep grid view
    }

    private void SetViewModeList()
    {
        // In a full implementation, this would toggle CSS classes
        // For now, just keep grid view
    }

    private async Task AddToCart(int carId)
    {
        try
        {
            var addToCartModel = new AddToCartDto { ProductId = carId, Quantity = 1 };
            var response = await CartService.AddToCartAsync(addToCartModel);
            if (response.Success)
            {
                successMessage = "Car added to cart successfully!";
            }
            else
            {
                errorMessage = response.Message ?? "Failed to add car to cart.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error adding car to cart.";
            Console.WriteLine($"Add to cart error: {ex.Message}");
        }
    }

    private async Task ToggleWishlist(int carId)
    {
        try
        {
            var response = await WishlistService.ToggleWishlistAsync(carId);
            if (response.Success)
            {
                successMessage = response.Message ?? "Wishlist updated!";
            }
            else
            {
                errorMessage = response.Message ?? "Failed to update wishlist.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error updating wishlist.";
            Console.WriteLine($"Wishlist error: {ex.Message}");
        }
    }

    private void QuickView(int carId)
    {
        NavManager.NavigateTo($"/product/{carId}");
    }

    private void EditCar(int carId)
    {
        NavManager.NavigateTo($"/edit-listing/{carId}");
    }

    private async Task DeleteCar(int carId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this car?");
        if (confirmed)
        {
            try
            {
                var response = await CarListingService.DeleteCarAsync(carId);
                if (response.Success)
                {
                    successMessage = "Car deleted successfully!";
                    await ApplyFilters(); // Refresh the list
                }
                else
                {
                    errorMessage = response.Message ?? "Failed to delete car.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = "Error deleting car.";
                Console.WriteLine($"Delete car error: {ex.Message}");
            }
        }
    }

    // Quantity adjustment methods
    private void IncreasePriceMin()
    {
        filterModel.MinPrice = (filterModel.MinPrice ?? 0) + 1000;
    }

    private void DecreasePriceMin()
    {
        if ((filterModel.MinPrice ?? 0) > 0)
        {
            filterModel.MinPrice = (filterModel.MinPrice ?? 0) - 1000;
        }
    }

    private void IncreasePriceMax()
    {
        filterModel.MaxPrice = (filterModel.MaxPrice ?? 500000) + 1000;
    }

    private void DecreasePriceMax()
    {
        if ((filterModel.MaxPrice ?? 500000) > 0)
        {
            filterModel.MaxPrice = (filterModel.MaxPrice ?? 500000) - 1000;
        }
    }

    private void IncreaseYearMin()
    {
        filterModel.MinYear = (filterModel.MinYear ?? 2010) + 1;
    }

    private void DecreaseYearMin()
    {
        if ((filterModel.MinYear ?? 2010) > 1900)
        {
            filterModel.MinYear = (filterModel.MinYear ?? 2010) - 1;
        }
    }

    private void IncreaseYearMax()
    {
        filterModel.MaxYear = (filterModel.MaxYear ?? 2025) + 1;
    }

    private void DecreaseYearMax()
    {
        if ((filterModel.MaxYear ?? 2025) > 1900)
        {
            filterModel.MaxYear = (filterModel.MaxYear ?? 2025) - 1;
        }
    }

    private void IncreaseMileage()
    {
        filterModel.MaxMileage = (filterModel.MaxMileage ?? 200000) + 10000;
    }

    private void DecreaseMileage()
    {
        if ((filterModel.MaxMileage ?? 200000) > 0)
        {
            filterModel.MaxMileage = (filterModel.MaxMileage ?? 200000) - 10000;
        }
    }

    private async Task<bool> IsInCompare(int carId)
    {
        try
        {
            return await CompareService.IsInCompareAsync(carId);
        }
        catch
        {
            return false;
        }
    }

    private async Task ToggleCompare(CarListingDto car)
    {
        try
        {
            var isInCompare = compareStatus.ContainsKey(car.Id) && compareStatus[car.Id];
            if (isInCompare)
            {
                await CompareService.RemoveFromCompareAsync(car.Id);
                compareStatus[car.Id] = false;
                successMessage = "Removed from compare";
            }
            else
            {
                var added = await CompareService.AddToCompareAsync(car);
                if (added)
                {
                    compareStatus[car.Id] = true;
                    successMessage = "Added to compare";
                }
                else
                {
                    errorMessage = "Compare list is full (max 4 cars). Remove a car first.";
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = "Error updating compare list.";
            Console.WriteLine($"Compare error: {ex.Message}");
        }
    }

    private string GetImageUrl(string? imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
            return "/images/noimage.jpg";
        
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
            return imagePath;
        
        var apiBaseUrl = "http://localhost:5237";
        if (imagePath.StartsWith("/"))
            return $"{apiBaseUrl}{imagePath}";
        
        return $"{apiBaseUrl}/images/{imagePath}";
    }
}
