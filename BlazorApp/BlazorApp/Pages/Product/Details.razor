@page "/product/{productId:int}"
@using BlazorApp.Services
@using BlazorApp.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.Json
@inject ICarListingService CarListingService
@inject IWishlistService WishlistService
@inject IMessageService MessageService
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject ICompareService CompareService

@if (listing == null)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading car details...</p>
    </div>
}
else
{
    <!-- BREADCRUMB -->
    <div class="bg-light py-3">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="/shop" class="text-decoration-none">Cars</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@listing.Name</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- HERO SECTION -->
    <div class="bg-gradient-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-2">@listing.Name</h1>
                    <p class="lead mb-3">@listing.Brand @listing.Year • @listing.Condition</p>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="h2 text-warning fw-bold mb-0">@listing.Price.ToString("N0") TND</span>
                        <div class="d-flex align-items-center">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= listing.Rating)
                                {
                                    <i class="fa fa-star text-warning"></i>
                                }
                                else
                                {
                                    <i class="fa fa-star-o text-warning"></i>
                                }
                            }
                            <small class="text-muted ms-2">(@listing.Rating.ToString("F1"))</small>
                        </div>
                        @if (!listing.IsApproved)
                        {
                            <span class="badge bg-warning text-dark">Pending Approval</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        @if (listing.QuantityInStock == 0)
                        {
                            <span class="badge bg-danger ms-2">Sold Out</span>
                        }
                        else if (listing.QuantityInStock <= 2)
                        {
                            <span class="badge bg-warning text-dark ms-2">Only @listing.QuantityInStock left!</span>
                        }
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex gap-2 justify-content-lg-end flex-wrap">
                                @if (listing.IsAvailableForRental && listing.RentalStock > 0)
                                {
                                    <button class="btn btn-info btn-lg px-4" @onclick="RentCar">
                                        <i class="fa fa-calendar me-2"></i>Rent Car
                                    </button>
                                }
                                @if (listing.QuantityInStock > 0)
                                {
                                    <button class="btn btn-light btn-lg px-4" @onclick="AddToCart">
                                        <i class="fa fa-shopping-cart me-2"></i>Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-lg px-4" disabled>
                                        <i class="fa fa-times-circle me-2"></i>Sold Out
                                    </button>
                                }
                                <button class="btn @(isInWishlist ? "btn-warning" : "btn-outline-light") btn-lg px-4" @onclick="ToggleWishlist">
                                    <i class="fa @(isInWishlist ? "fa-heart" : "fa-heart-o") me-2"></i>
                                    @(isInWishlist ? "In Wishlist" : "Add to Wishlist")
                                </button>
                                <button class="btn @(isInCompare ? "btn-info" : "btn-outline-light") btn-lg px-4" @onclick="ToggleCompare">
                                    <i class="fa @(isInCompare ? "fa-check" : "fa-exchange") me-2"></i>
                                    @(isInCompare ? "In Compare" : "Add to Compare")
                                </button>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <button class="btn btn-light btn-lg px-4" @onclick='() => NavManager.NavigateTo("/login")'>
                                <i class="fa fa-sign-in me-2"></i>Login to Purchase
                            </button>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="container py-5">
        <div class="row">
            <!-- Car Images -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-lg overflow-hidden">
                    <div class="position-relative">
                        @if (allImages.Any())
                        {
                            <div id="carImageCarousel" class="carousel slide" data-bs-ride="false">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < allImages.Count; i++)
                                    {
                                        var image = allImages[i];
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@GetImageUrl(image)" class="d-block w-100" alt="@listing.Name"
                                                 style="height: 500px; object-fit: cover;">
                                        </div>
                                    }
                                </div>
                                @if (allImages.Count > 1)
                                {
                                    <button class="carousel-control-prev" type="button" data-bs-target="#carImageCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carImageCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Next</span>
                                    </button>
                                }
                            </div>

                            @if (allImages.Count > 1)
                            {
                                <div class="mt-3">
                                    <div class="row g-2">
                                        @for (int i = 0; i < allImages.Count; i++)
                                        {
                                            var image = allImages[i];
                                            var index = i;
                                            <div class="col-auto">
                                                <img src="@GetImageUrl(image)" class="img-thumbnail @(currentImageIndex == index ? "border-primary" : "")"
                                                     style="width: 80px; height: 60px; object-fit: cover; cursor: pointer;"
                                                     @onclick="() => GoToSlide(index)" alt="Thumbnail @(index + 1)">
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <img src="/images/noimage.jpg" class="card-img-top" alt="@listing.Name"
                                 style="height: 500px; object-fit: cover;">
                        }

                        @if (listing.Condition == "New")
                        {
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-success fs-6 px-3 py-2">NEW</span>
                            </div>
                        }
                        else
                        {
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">USED</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Key Specifications -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="fa fa-info-circle me-2"></i>Key Specifications</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-center p-3 bg-light rounded-3 h-100">
                                    <i class="fa fa-tachometer-alt fa-2x text-primary mb-2"></i>
                                    <div class="small text-muted fw-semibold">Mileage</div>
                                    <div class="fw-bold text-dark">@listing.Mileage.ToString("N0") km</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-3 bg-light rounded-3 h-100">
                                    <i class="fa fa-gas-pump fa-2x text-primary mb-2"></i>
                                    <div class="small text-muted fw-semibold">Fuel Type</div>
                                    <div class="fw-bold text-dark">@listing.FuelType</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-3 bg-light rounded-3 h-100">
                                    <i class="fa fa-cogs fa-2x text-primary mb-2"></i>
                                    <div class="small text-muted fw-semibold">Transmission</div>
                                    <div class="fw-bold text-dark">@listing.Transmission</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-3 bg-light rounded-3 h-100">
                                    <i class="fa fa-palette fa-2x text-primary mb-2"></i>
                                    <div class="small text-muted fw-semibold">Color</div>
                                    <div class="fw-bold text-dark">@listing.Color</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card border-0 shadow-lg">
                    <div class="card-body">
                        <h6 class="card-title mb-3"><i class="fa fa-bolt me-2 text-warning"></i>Quick Actions</h6>
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" @onclick="ContactSeller">
                                <i class="fa fa-envelope me-2"></i>Contact Seller
                            </button>
                            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/shop")'>
                                <i class="fa fa-arrow-left me-2"></i>Back to Listings
                            </button>
                            <AuthorizeView>
                                <Authorized>
                                    @if (canEdit)
                                    {
                                        <button class="btn btn-outline-warning" @onclick='() => NavManager.NavigateTo($"/edit-listing/{listing.ProductId}")'>
                                            <i class="fa fa-edit me-2"></i>Edit Listing
                                        </button>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Information Section -->
        <div class="row mt-5">
            <div class="col-lg-8">
                <!-- Full Specifications -->
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-dark text-white">
                        <h4 class="mb-0"><i class="fa fa-info-circle me-2"></i>Complete Specifications</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="spec-group mb-4">
                                    <h6 class="text-muted mb-3">Basic Information</h6>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Brand:</span>
                                        <strong>@listing.Brand</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Model:</span>
                                        <strong>@listing.Name</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Year:</span>
                                        <strong>@listing.Year</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Condition:</span>
                                        <strong>@listing.Condition</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="spec-group mb-4">
                                    <h6 class="text-muted mb-3">Technical Details</h6>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Mileage:</span>
                                        <strong>@listing.Mileage.ToString("N0") km</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Fuel Type:</span>
                                        <strong>@listing.FuelType</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Transmission:</span>
                                        <strong>@listing.Transmission</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom align-items-center">
                                        <span>Color:</span>
                                        <strong class="d-flex align-items-center">
                                            <div style="width: 20px; height: 20px; background-color: @listing.Color; border: 1px solid #ccc; border-radius: 50%; margin-right: 8px;"></div>
                                            @listing.Color
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Specs -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="spec-group">
                                    <h6 class="text-muted mb-3">Engine & Performance</h6>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Engine Size:</span>
                                        <strong>@(listing.EngineSize?.ToString("F1") ?? "N/A") L</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Horsepower:</span>
                                        <strong>@(listing.Horsepower?.ToString() ?? "N/A") HP</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="spec-group">
                                    <h6 class="text-muted mb-3">Capacity</h6>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Doors:</span>
                                        <strong>@(listing.Doors?.ToString() ?? "N/A")</strong>
                                    </div>
                                    <div class="spec-item d-flex justify-content-between py-2 border-bottom">
                                        <span>Seats:</span>
                                        <strong>@(listing.Seats?.ToString() ?? "N/A")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(listing.VIN))
                        {
                            <div class="mt-4 pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted">VIN Number:</span>
                                    <code class="bg-light px-2 py-1 rounded">@listing.VIN</code>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Description -->
                @if (!string.IsNullOrEmpty(listing.Description))
                {
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fa fa-align-left me-2"></i>Description</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-0 lead">@listing.Description</p>
                        </div>
                    </div>
                }

                <!-- Features -->
                @if (!string.IsNullOrEmpty(listing.Features))
                {
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fa fa-star me-2"></i>Features & Equipment</h5>
                        </div>
                        <div class="card-body">
                            <div class="features-list">
                                @foreach (var feature in listing.Features.Split(new[] { '\n', ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-light text-dark me-2 mb-2 px-3 py-2">
                                        <i class="fa fa-check text-success me-1"></i>@feature.Trim()
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Location -->
                @if (!string.IsNullOrEmpty(listing.Location))
                {
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="fa fa-map-marker-alt me-2"></i>Location</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-map-marker fa-2x text-info me-3"></i>
                                <div>
                                    <h6 class="mb-0">@listing.Location</h6>
                                    <small class="text-muted">Vehicle location</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Category & Status -->
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0"><i class="fa fa-tag me-2"></i>Listing Information</h6>
                    </div>
                    <div class="card-body">
                        @if (listing.Category != null)
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block">Category</small>
                                <span class="badge bg-primary fs-6">@listing.Category.CategoryName</span>
                            </div>
                        }
                        <div class="mb-3">
                            <small class="text-muted d-block">Availability</small>
                            <span class="badge @(listing.QuantityInStock > 0 ? "bg-success" : "bg-danger") fs-6">
                                @(listing.QuantityInStock > 0 ? $"{listing.QuantityInStock} in stock" : "Out of stock")
                            </span>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">Condition</small>
                            <span class="badge @(listing.Condition == "New" ? "bg-success" : "bg-warning text-dark") fs-6">
                                @listing.Condition
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Listing Timeline -->
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-dark text-white">
                        <h6 class="mb-0"><i class="fa fa-calendar me-2"></i>Timeline</h6>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            <div class="timeline-item mb-3">
                                <div class="d-flex">
                                    <div class="timeline-marker bg-primary me-3" style="width: 12px; height: 12px; border-radius: 50%; margin-top: 4px;"></div>
                                    <div>
                                        <small class="text-muted">Listed</small>
                                        <div class="fw-bold">@listing.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                            </div>
                            @if (listing.UpdatedAt.HasValue)
                            {
                                <div class="timeline-item mb-3">
                                    <div class="d-flex">
                                        <div class="timeline-marker bg-warning me-3" style="width: 12px; height: 12px; border-radius: 50%; margin-top: 4px;"></div>
                                        <div>
                                            <small class="text-muted">Updated</small>
                                            <div class="fw-bold">@listing.UpdatedAt.Value.ToString("MMM dd, yyyy")</div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (listing.IsApproved && listing.ApprovedAt.HasValue)
                            {
                                <div class="timeline-item">
                                    <div class="d-flex">
                                        <div class="timeline-marker bg-success me-3" style="width: 12px; height: 12px; border-radius: 50%; margin-top: 4px;"></div>
                                        <div>
                                            <small class="text-muted">Approved</small>
                                            <div class="fw-bold">@listing.ApprovedAt.Value.ToString("MMM dd, yyyy")</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Seller Information -->
                @if (listing.Seller != null)
                {
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="fa fa-user me-2"></i>Seller Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-circle bg-primary text-white me-3" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <i class="fa fa-user"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">@listing.Seller.UserName</h6>
                                    <small class="text-muted">Verified Seller</small>
                                </div>
                            </div>
                            <button class="btn btn-primary w-100" @onclick="ContactSeller">
                                <i class="fa fa-envelope me-2"></i>Contact Seller
                            </button>
                        </div>
                    </div>
                }

                <!-- Quick Links -->
                <div class="card border-0 shadow-lg">
                    <div class="card-body">
                        <h6 class="card-title mb-3"><i class="fa fa-link me-2 text-primary"></i>Quick Links</h6>
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/shop")'>
                                <i class="fa fa-arrow-left me-2"></i>Back to Listings
                            </button>
                            <button class="btn btn-outline-danger" @onclick='() => NavManager.NavigateTo("/wishlist")'>
                                <i class="fa fa-heart me-2"></i>My Wishlist
                            </button>
                            <button class="btn btn-outline-success" @onclick='() => NavManager.NavigateTo("/cart")'>
                                <i class="fa fa-shopping-cart me-2"></i>My Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int productId { get; set; }

    private CarListingDto listing;
    private List<string> allImages = new();
    private int currentImageIndex = 0;
    private bool isInWishlist = false;
    private bool isInCompare = false;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listing = await CarListingService.GetListingByIdAsync(productId);
            
            // Increment view count
            _ = CarListingService.IncrementViewsAsync(productId); // Fire and forget
            
            // Load images
            LoadImages();
            
            // Check wishlist status
            try
            {
                isInWishlist = await WishlistService.IsInWishlistAsync(productId);
            }
            catch { }
            
            // Check compare status
            try
            {
                isInCompare = await CompareService.IsInCompareAsync(productId);
            }
            catch { }

            // Check edit permissions
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                canEdit = user.IsInRole("Admin") || user.IsInRole("Manager") || listing.SellerId == userId;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading listing: {ex.Message}");
        }
    }

    private void LoadImages()
    {
        allImages.Clear();
        
        if (!string.IsNullOrEmpty(listing.Image))
        {
            allImages.Add(listing.Image);
        }

        if (!string.IsNullOrEmpty(listing.AdditionalImages))
        {
            try
            {
                var additional = JsonSerializer.Deserialize<List<string>>(listing.AdditionalImages);
                if (additional != null && additional.Any())
                {
                    allImages.AddRange(additional);
                }
            }
            catch { }
        }
    }

    private string GetImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
        {
            return "/images/noimage.jpg";
        }
        
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
        {
            return imagePath;
        }
        
        // Backend returns paths like "/images/filename.png"
        // Prepend API base URL
        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5237";
        if (imagePath.StartsWith("/"))
        {
            return $"{apiBaseUrl}{imagePath}";
        }
        
        return $"{apiBaseUrl}/images/{imagePath}";
    }

    private async Task GoToSlide(int index)
    {
        currentImageIndex = index;
        await JSRuntime.InvokeVoidAsync("goToCarouselSlide", "carImageCarousel", index);
        StateHasChanged();
    }

    private void NavigateCarousel(int direction)
    {
        // This method is no longer needed as we're using Bootstrap's native controls
        // Keeping it for backward compatibility but it won't be called
        if (allImages.Count <= 1) return;
        
        currentImageIndex += direction;
        if (currentImageIndex < 0)
        {
            currentImageIndex = allImages.Count - 1;
        }
        else if (currentImageIndex >= allImages.Count)
        {
            currentImageIndex = 0;
        }
        
        StateHasChanged();
    }

    private async Task ToggleWishlist()
    {
        if (isInWishlist)
        {
            var success = await WishlistService.RemoveFromWishlistAsync(productId);
            if (success)
            {
                isInWishlist = false;
            }
        }
        else
        {
            var success = await WishlistService.AddToWishlistAsync(productId);
            if (success)
            {
                isInWishlist = true;
            }
        }
    }

    private async Task ToggleCompare()
    {
        if (listing == null) return;
        
        try
        {
            if (isInCompare)
            {
                await CompareService.RemoveFromCompareAsync(listing.Id);
                isInCompare = false;
            }
            else
            {
                var added = await CompareService.AddToCompareAsync(listing);
                if (added)
                {
                    isInCompare = true;
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Compare list is full (max 4 cars). Remove a car first.");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling compare: {ex.Message}");
        }
    }

    private async Task AddToCart()
    {
        try
        {
            NavManager.NavigateTo($"/cart/add/{productId}");
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding to cart: {ex.Message}");
        }
    }

    private void RentCar()
    {
        NavManager.NavigateTo($"/rent-car/{productId}");
    }

    private void ContactSeller()
    {
        if (listing.SellerId != null)
        {
            NavManager.NavigateTo($"/compose-message?recipientId={listing.SellerId}&listingId={productId}");
        }
    }
}
