@page "/messages"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize]
@inject IMessageService MessageService
@inject NavigationManager NavigationManager

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Messages</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li class="active">Messages</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fa fa-inbox me-2"></i>Inbox</h2>
                <div>
                    <button class="btn btn-outline-primary me-2" @onclick='() => NavigationManager.NavigateTo("/messages/sent")'>
                        <i class="fa fa-paper-plane me-1"></i>Sent
                    </button>
                    <button class="btn btn-success me-2" @onclick='() => NavigationManager.NavigateTo("/compose-message")'>
                        <i class="fa fa-plus me-1"></i>Compose New
                    </button>
                    <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/shop")'>
                        <i class="fa fa-arrow-left me-1"></i>Back to Cars
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (isLoading)
            {
                <p>Loading messages...</p>
            }
            else if (messages != null && messages.Any())
            {
                <div class="card shadow">
                    <div class="list-group list-group-flush">
                        @foreach (var message in messages)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-1">
                                            <h6 class="mb-0 me-2">@message.Subject</h6>
                                            @if (!message.IsRead)
                                            {
                                                <span class="badge bg-primary">New</span>
                                            }
                                        </div>
                                        <p class="text-muted small mb-1">
                                            From: @(string.IsNullOrEmpty(message.SenderName) ? "Unknown" : message.SenderName)
                                            @if (message.ListingId.HasValue)
                                            {
                                                <span>• About Listing #@message.ListingId</span>
                                            }
                                        </p>
                                        <p class="text-muted small mb-0">@message.SentAt.ToString("MMM dd, yyyy HH:mm")</p>
                                    </div>
                                    <div class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewMessage(message.Id)">
                                            <i class="fa fa-eye"></i> View
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa fa-envelope fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No messages yet</h4>
                    <p class="text-muted">Messages from buyers interested in your cars will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>
    </div>
</div>
<!-- /SECTION -->

@code {
    private List<MessageDto> messages = new();
    private bool isLoading = true;
    private string successMessage = "";
    private bool showInbox = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadInboxMessages();
    }

    private async Task LoadInboxMessages()
    {
        try
        {
            isLoading = true;
            messages = await MessageService.GetInboxMessagesAsync();
            showInbox = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowSent()
    {
        try
        {
            isLoading = true;
            messages = await MessageService.GetSentMessagesAsync();
            showInbox = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sent messages: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewMessage(int messageId)
    {
        NavigationManager.NavigateTo($"/message/{messageId}");
    }
}