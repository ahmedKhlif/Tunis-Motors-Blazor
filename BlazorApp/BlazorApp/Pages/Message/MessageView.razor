@page "/message/{messageId:int}"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize]
@inject IMessageService MessageService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<div class="container-fluid py-4">
    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (message != null)
    {
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@message.Subject</h5>
                        <small class="opacity-75">
                            <i class="fa fa-user me-1"></i>From: @message.SenderName | 
                            <i class="fa fa-clock me-1"></i>@message.SentAt.ToString("MMMM dd, yyyy - HH:mm")
                        </small>
                    </div>
                    <button class="btn btn-sm btn-danger" @onclick="ConfirmDelete">
                        <i class="fa fa-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small">Message Content:</label>
                    <p class="mt-2" style="white-space: pre-wrap;">@message.Content</p>
                </div>
                @if (message.ListingId.HasValue)
                {
                    <div class="alert alert-info">
                        <i class="fa fa-car me-2"></i>
                        <strong>Related to Listing #@message.ListingId</strong>
                    </div>
                }
            </div>
            <div class="card-footer bg-light">
                <div class="d-flex gap-2">
                    <button class="btn btn-success" @onclick="ReplyMessage">
                        <i class="fa fa-reply me-1"></i>Reply
                    </button>
                    <button class="btn btn-outline-primary" @onclick='() => NavManager.NavigateTo("/messages")'>
                        <i class="fa fa-inbox me-1"></i>Back to Inbox
                    </button>
                    <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/messages/sent")'>
                        <i class="fa fa-paper-plane me-1"></i>Sent Messages
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle me-2"></i>Message not found.
        </div>
    }
</div>

@code {
    [Parameter]
    public int messageId { get; set; }

    private MessageDto? message;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            message = await MessageService.GetMessageAsync(messageId);
            if (message != null && !message.IsRead)
            {
                await MessageService.MarkAsReadAsync(messageId);
                message.IsRead = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading message: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (message == null) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this message?");
        if (confirmed)
        {
            try
            {
                await MessageService.DeleteMessageAsync(message.Id);
                NavManager.NavigateTo("/messages");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting message: {ex.Message}");
            }
        }
    }

    private void ReplyMessage()
    {
        if (message != null)
        {
            NavManager.NavigateTo($"/compose-message?recipientId={message.SenderId}&subject=Re: {message.Subject}");
        }
    }
}
