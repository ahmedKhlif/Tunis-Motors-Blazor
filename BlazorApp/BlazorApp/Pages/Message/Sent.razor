@page "/messages/sent"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize]
@inject IMessageService MessageService
@inject NavigationManager NavigationManager

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fa fa-paper-plane me-2"></i>Sent Messages</h4>
                        <button class="btn btn-light btn-sm" @onclick='() => NavigationManager.NavigateTo("/compose-message")'>
                            <i class="fa fa-plus me-1"></i>Compose New
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (messages != null && messages.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Subject</th>
                                        <th>To</th>
                                        <th>Listing</th>
                                        <th>Sent Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var message in messages)
                                    {
                                        <tr>
                                            <td><strong>@message.Subject</strong></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(message.ReceiverName))
                                                {
                                                    <span>@message.ReceiverName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unknown</span>
                                                }
                                            </td>
                                            <td>
                                                @if (message.ListingId.HasValue)
                                                {
                                                    <span>Listing #@message.ListingId</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@message.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="fa fa-check me-1"></i>Sent
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-info" @onclick="() => ViewMessage(message.Id)">
                                                    <i class="fa fa-eye"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa fa-paper-plane fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No sent messages</h5>
                            <p class="text-muted">You haven't sent any messages yet.</p>
                            <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/compose-message")'>
                                <i class="fa fa-plus me-2"></i>Send Your First Message
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="mt-3">
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-primary" @onclick="ShowInbox">
                        <i class="fa fa-inbox me-1"></i>Inbox
                    </button>
                    <button class="btn btn-primary">
                        <i class="fa fa-paper-plane me-1"></i>Sent
                    </button>
                    <button class="btn btn-outline-success" @onclick='() => NavigationManager.NavigateTo("/compose-message")'>
                        <i class="fa fa-plus me-1"></i>Compose
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MessageDto> messages = new();
    private bool isLoading = true;
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSentMessages();
    }

    private async Task LoadSentMessages()
    {
        try
        {
            isLoading = true;
            messages = await MessageService.GetSentMessagesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sent messages: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowInbox()
    {
        NavigationManager.NavigateTo("/messages");
    }

    private void ViewMessage(int messageId)
    {
        NavigationManager.NavigateTo($"/message/{messageId}");
    }
}