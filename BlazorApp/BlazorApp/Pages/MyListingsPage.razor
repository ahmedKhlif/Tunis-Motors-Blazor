@page "/my-listings"
@using BlazorApp.Models
@using BlazorApp.Services
@inject ICarListingService CarListingService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">My Listings</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li><a href="/seller-dashboard">Seller Dashboard</a></li>
                    <li class="active">My Listings</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fa fa-car"></i> My Listings</h1>
        <a href="/create-listing" class="btn btn-danger">
            <i class="fa fa-plus"></i> Create New Listing
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (listings == null || listings.Count == 0)
    {
        <div class="alert alert-info">
            <h5>No Listings Yet</h5>
            <p>You haven't created any car listings yet. Start by creating your first listing!</p>
            <a href="/create-listing" class="btn btn-danger mt-2">
                <i class="fa fa-plus"></i> Create Your First Listing
            </a>
        </div>
    }
    else
    {
        <!-- Tabs for filtering -->
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link @(filterStatus == null ? "active" : "")" @onclick="() => SetFilter()">
                    All (@listings.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(filterStatus == "approved" ? "active" : "")" @onclick="@(() => SetFilter("approved"))">
                    <i class="fa fa-check text-success"></i> Approved (@GetCountByStatus("approved"))
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(filterStatus == "pending" ? "active" : "")" @onclick="@(() => SetFilter("pending"))">
                    <i class="fa fa-clock-o text-warning"></i> Pending (@GetCountByStatus("pending"))
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(filterStatus == "rejected" ? "active" : "")" @onclick="@(() => SetFilter("rejected"))">
                    <i class="fa fa-times text-danger"></i> Rejected (@GetCountByStatus("rejected"))
                </button>
            </li>
        </ul>

        <!-- Listings Table -->
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Car Details</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Views</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var listing in GetFilteredListings())
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(listing.Image))
                                        {
                                            <img src="@GetImageUrl(listing.Image)" alt="@listing.Name" style="width: 80px; height: 80px; object-fit: cover; margin-right: 15px; border-radius: 4px;">
                                        }
                                        else
                                        {
                                            <div style="width: 80px; height: 80px; background-color: #e9ecef; margin-right: 15px; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                                <i class="fa fa-car text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <a href="/product/@listing.ProductId" class="text-decoration-none">
                                                <strong>@listing.Name</strong>
                                            </a><br>
                                            <small class="text-muted">@listing.Brand @listing.Year • @listing.Mileage.ToString("N0") km • @listing.FuelType</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <strong style="color: #d10024;">@listing.Price.ToString("N0") TND</strong>
                                </td>
                                <td>
                                    @if (listing.IsApproved)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa fa-check"></i> Approved
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(listing.AdminApprovalNote))
                                    {
                                        <span class="badge bg-danger" title="@(listing.AdminApprovalNote ?? "No reason provided")">
                                            <i class="fa fa-times"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa fa-clock-o"></i> Pending
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@listing.Views <i class="fa fa-eye"></i></span>
                                </td>
                                <td>
                                    <small>@listing.CreatedAt.ToString("dd MMM yyyy")</small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/product/@listing.ProductId" class="btn btn-sm btn-outline-primary" title="View Listing">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditListing(listing)" title="Edit Listing">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteConfirm(listing)" title="Delete Listing">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            <i class="fa fa-exclamation-circle me-2"></i> @errorMessage
        </div>
    }
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && selectedListing != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Listing</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this listing?</p>
                    <div class="alert alert-warning">
                        <strong>@selectedListing.Name</strong> (@selectedListing.Year)<br>
                        <small>Price: @selectedListing.Price.ToString("N0") TND</small>
                    </div>
                    <p class="text-muted small">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Keep Listing</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteListingAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        <i class="fa fa-trash"></i> Delete Listing
                    </button>
                </div>
            </div>
        </div>
    </div>
}
  
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3">
            <i class="fa fa-check-circle me-2"></i> @successMessage
        </div>
    }

<style>
    .nav-link {
        cursor: pointer;
        color: #6c757d;
        background: none;
        border: none;
    }

    .nav-link:hover {
        color: #d10024;
    }

    .nav-link.active {
        color: #d10024;
        border-bottom-color: #d10024;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn-group {
        gap: 5px;
    }
</style>

@code {
    private List<CarListingDto> listings = new();
    private string filterStatus = null;
    private CarListingDto selectedListing;
    private bool showDeleteModal = false;
    private bool isLoading = true;
    private bool isDeleting = false;
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadListings(currentUser.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading page: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadListings(string userId)
    {
        isLoading = true;
        try
        {
            // Load user's listings from API
            listings = await CarListingService.GetUserListingsAsync(userId);
            if (listings == null)
                listings = new List<CarListingDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading listings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string? status = null)
    {
        filterStatus = status;
    }

    private List<CarListingDto> GetFilteredListings()
    {
        if (filterStatus == null) return listings;

        return listings.Where(l =>
            filterStatus == "approved" ? l.IsApproved :
            filterStatus == "pending" ? !l.IsApproved && string.IsNullOrEmpty(l.AdminApprovalNote) :
            filterStatus == "rejected" ? !l.IsApproved && !string.IsNullOrEmpty(l.AdminApprovalNote) :
            false
        ).ToList();
    }

    private int GetCountByStatus(string status)
    {
        return status switch
        {
            "approved" => listings.Count(l => l.IsApproved),
            "pending" => listings.Count(l => !l.IsApproved && string.IsNullOrEmpty(l.AdminApprovalNote)),
            "rejected" => listings.Count(l => !l.IsApproved && !string.IsNullOrEmpty(l.AdminApprovalNote)),
            _ => 0
        };
    }

    private void EditListing(CarListingDto listing)
    {
        // Navigate to edit page
        NavigationManager.NavigateTo($"/edit-listing/{listing.ProductId}");
    }

    private void ShowDeleteConfirm(CarListingDto listing)
    {
        selectedListing = listing;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedListing = null;
    }

    private async Task DeleteListingAsync()
    {
        if (selectedListing == null) return;

        try
        {
            isDeleting = true;
            var result = await CarListingService.DeleteListingAsync(selectedListing.ProductId);
            
            if (result)
            {
                listings.Remove(selectedListing);
                CloseDeleteModal();
            }
            else
            {
                errorMessage = "Failed to delete listing. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting listing: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string GetImageUrl(string? imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
            return "/images/noimage.jpg";
        
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
            return imagePath;
        
        var apiBaseUrl = "http://localhost:5237";
        if (imagePath.StartsWith("/"))
            return $"{apiBaseUrl}{imagePath}";
        
        return $"{apiBaseUrl}/images/{imagePath}";
    }
}

