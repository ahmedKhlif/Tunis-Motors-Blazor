@page "/admin/edit-role/{roleId}"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IAdminService AdminService
@inject NavigationManager NavigationManager

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fa fa-edit me-2"></i>Edit Role: @role?.Name</h2>
                <a href="/admin/list-roles" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left me-2"></i>Back to Roles
                </a>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading role details...</p>
                </div>
            }
            else if (role != null)
            {
                <!-- Role Name Edit -->
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fa fa-tag me-2"></i>Role Information</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="editRoleModel" OnValidSubmit="HandleUpdateRole" FormName="editRoleForm">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />

                            <div class="mb-3">
                                <label for="roleName" class="form-label">Role Name</label>
                                <InputText id="roleName" class="form-control" @bind-Value="editRoleModel.RoleName" />
                                <ValidationMessage For="() => editRoleModel.RoleName" class="text-danger" />
                            </div>

                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <text><span class="spinner-border spinner-border-sm me-2" role="status"></span>Updating...</text>
                                }
                                else
                                {
                                    <text><i class="fa fa-save me-2"></i>Update Role</text>
                                }
                            </button>
                        </EditForm>
                    </div>
                </div>

                <!-- Users in Role Display -->
                <div class="card shadow">
                    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fa fa-users me-2"></i>Users in Role</h5>
                        <span class="badge bg-light text-dark">@usersInRole.Count users</span>
                    </div>
                    <div class="card-body">
                        @if (usersInRole.Any())
                        {
                            <div class="list-group mb-3">
                                @foreach (var user in usersInRole)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@user.UserName</strong>
                                                <span class="text-muted ms-2">@user.Email</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fa fa-users fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No users are currently assigned to this role.</p>
                            </div>
                        }
                        
                        <div class="mt-3">
                            <a href="/admin/manage-users-in-role/@RoleId" class="btn btn-primary">
                                <i class="fa fa-user-cog me-2"></i>Add or Remove Users
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle me-2"></i>Role not found.
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string RoleId { get; set; }

    private RoleDto role;
    private List<UserDto> usersInRole = new();
    private EditRoleModel editRoleModel = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleData();
    }

    private async Task LoadRoleData()
    {
        try
        {
            isLoading = true;
            role = await AdminService.GetRoleByIdAsync(RoleId);

            if (role != null)
            {
                editRoleModel.RoleName = role.Name;
                usersInRole = await AdminService.GetUsersInRoleAsync(role.Id) ?? new List<UserDto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load role data.";
            Console.WriteLine($"Load role data error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdateRole()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var result = await AdminService.UpdateRoleAsync(RoleId, editRoleModel.RoleName);
            if (result.Success)
            {
                successMessage = "Role updated successfully!";
                role.Name = editRoleModel.RoleName;
            }
            else
            {
                errorMessage = result.Message ?? "Failed to update role.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Update role error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class EditRoleModel
    {
        [Required(ErrorMessage = "Role name is required")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Role name must be between 2 and 50 characters")]
        public string RoleName { get; set; } = "";
    }
}