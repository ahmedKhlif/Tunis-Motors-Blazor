@page "/admin/approvals"
@using BlazorApp.Services
@using BlazorApp.Models
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IApprovalService ApprovalService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Car Approvals</h3>
                <ul class="breadcrumb-tree">
                    <li><a href="/">Home</a></li>
                    <li><a href="/admin">Dashboard</a></li>
                    <li class="active">Approvals</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /BREADCRUMB -->

<!-- SECTION -->
<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="fa fa-clipboard-check me-2"></i>Car Listing Approvals</h2>
                    <a href="/admin" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"></i>Back to Dashboard
                    </a>
                </div>

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa fa-check-circle me-2"></i>@successMessage
                        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa fa-exclamation-circle me-2"></i>@errorMessage
                        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                    </div>
                }

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-4" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "pending" ? "active" : "")" 
                                @onclick='() => SwitchTab("pending")'
                                type="button">
                            <i class="fa fa-clock me-2"></i>Pending
                            @if (pendingListings.Count > 0)
                            {
                                <span class="badge bg-warning text-dark ms-2">@pendingListings.Count</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "approved" ? "active" : "")" 
                                @onclick='() => SwitchTab("approved")'
                                type="button">
                            <i class="fa fa-check-circle me-2"></i>Approved
                            @if (approvedListings.Count > 0)
                            {
                                <span class="badge bg-success ms-2">@approvedListings.Count</span>
                            }
                        </button>
                    </li>
                </ul>

                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3">Loading listings...</p>
                    </div>
                }
                else
                {
                    <!-- Pending Tab Content -->
                    @if (activeTab == "pending")
                    {
                        @if (pendingListings != null && pendingListings.Count > 0)
                        {
                            <div class="row">
                                @foreach (var car in pendingListings)
                                {
                                    <div class="col-xl-4 col-lg-6 mb-4">
                                        <div class="card h-100 shadow border-warning">
                                            <div class="position-relative">
                                                <img src="@GetImageUrl(car.Image)" class="card-img-top" alt="@car.Name"
                                                     style="height: 220px; object-fit: cover;" onerror="this.src='/images/noimage.jpg'">
                                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 px-3 py-2">
                                                    <i class="fa fa-clock me-1"></i>Pending Approval
                                                </span>
                                                @if (car.IsAvailableForRental && car.RentalStock > 0)
                                                {
                                                    <span class="badge bg-info position-absolute top-0 end-0 m-2 px-2 py-2">
                                                        <i class="fa fa-calendar me-1"></i>For Rent
                                                    </span>
                                                }
                                            </div>
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title">@car.Name</h5>
                                                <div class="mb-2">
                                                    <span class="h5 text-success fw-bold">@car.Price.ToString("N0") TND</span>
                                                    @if (car.DailyRentalRate.HasValue)
                                                    {
                                                        <span class="text-muted ms-2">/ @car.DailyRentalRate.Value.ToString("N0") TND/day</span>
                                                    }
                                                </div>
                                                
                                                <!-- Detailed Information -->
                                                <div class="car-details mb-3">
                                                    <div class="row g-2 small">
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-calendar text-primary me-1"></i>
                                                                <strong>Year:</strong> @car.Year
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-tachometer-alt text-primary me-1"></i>
                                                                <strong>Mileage:</strong> @car.Mileage.ToString("N0") km
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-gas-pump text-primary me-1"></i>
                                                                <strong>Fuel:</strong> @car.FuelType
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-cogs text-primary me-1"></i>
                                                                <strong>Trans:</strong> @car.Transmission
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-palette text-primary me-1"></i>
                                                                <strong>Color:</strong> @car.Color
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-star text-warning me-1"></i>
                                                                <strong>Condition:</strong> @car.Condition
                                                            </div>
                                                        </div>
                                                        @if (car.EngineSize.HasValue)
                                                        {
                                                            <div class="col-6">
                                                                <div class="detail-item">
                                                                    <i class="fa fa-cog text-primary me-1"></i>
                                                                    <strong>Engine:</strong> @car.EngineSize.Value.ToString("N1")L
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (car.Horsepower.HasValue)
                                                        {
                                                            <div class="col-6">
                                                                <div class="detail-item">
                                                                    <i class="fa fa-bolt text-primary me-1"></i>
                                                                    <strong>HP:</strong> @car.Horsepower HP
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Stock Information -->
                                                <div class="stock-info mb-3 p-2 bg-light rounded">
                                                    <div class="row g-2 small">
                                                        <div class="col-6">
                                                            <strong><i class="fa fa-shopping-cart me-1"></i>Sale Stock:</strong>
                                                            <span class="badge @(car.QuantityInStock > 0 ? "bg-success" : "bg-danger")">
                                                                @car.QuantityInStock
                                                            </span>
                                                        </div>
                                                        @if (car.IsAvailableForRental)
                                                        {
                                                            <div class="col-6">
                                                                <strong><i class="fa fa-calendar me-1"></i>Rental Stock:</strong>
                                                                <span class="badge @(car.RentalStock > 0 ? "bg-info" : "bg-danger")">
                                                                    @car.RentalStock
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Seller Information -->
                                                <div class="seller-info mb-3 p-2 bg-light rounded">
                                                    <div class="small">
                                                        <i class="fa fa-user me-1"></i><strong>Seller:</strong> @(car.Seller?.UserName ?? "Unknown")
                                                        <br />
                                                        <i class="fa fa-map-marker-alt me-1"></i><strong>Location:</strong> @(car.Location ?? "Not specified")
                                                        <br />
                                                        <i class="fa fa-calendar me-1"></i><strong>Submitted:</strong> @car.CreatedAt.ToString("MMM dd, yyyy")
                                                    </div>
                                                </div>

                                                <!-- Description -->
                                                @if (!string.IsNullOrEmpty(car.Description))
                                                {
                                                    <p class="card-text flex-grow-1 small text-muted" style="max-height: 60px; overflow: hidden;">
                                                        @(car.Description.Length > 120 ? car.Description.Substring(0, 120) + "..." : car.Description)
                                                </p>
                                                }

                                                <!-- Action Buttons -->
                                                <div class="mt-auto">
                                                    <div class="row g-2 mb-2">
                                                        <div class="col-6">
                                                            <button class="btn btn-outline-info btn-sm w-100" @onclick="() => ViewApprovalDetails(car.ProductId)">
                                                                <i class="fa fa-eye me-1"></i>Review Details
                                                            </button>
                                                        </div>
                                                        <div class="col-6">
                                                            <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => ViewProduct(car.ProductId)">
                                                                <i class="fa fa-external-link-alt me-1"></i>View Listing
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="row g-2">
                                                        <div class="col-6">
                                                            <button class="btn btn-success btn-sm w-100" @onclick="() => ShowApproveModal(car)">
                                                                <i class="fa fa-check me-1"></i>Approve
                                                            </button>
                                                        </div>
                                                        <div class="col-6">
                                                            <button class="btn btn-danger btn-sm w-100" @onclick="() => ShowRejectModal(car)">
                                                                <i class="fa fa-times me-1"></i>Reject
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-check-circle fa-4x text-success mb-3"></i>
                                <h4 class="text-muted">No Pending Approvals</h4>
                                <p class="text-muted">All car listings have been reviewed.</p>
                            </div>
                        }
                    }

                    <!-- Approved Tab Content -->
                    @if (activeTab == "approved")
                    {
                        @if (approvedListings != null && approvedListings.Count > 0)
                        {
                            <div class="row">
                                @foreach (var car in approvedListings)
                                {
                                    <div class="col-xl-4 col-lg-6 mb-4">
                                        <div class="card h-100 shadow border-success">
                                            <div class="position-relative">
                                                <img src="@GetImageUrl(car.Image)" class="card-img-top" alt="@car.Name"
                                                     style="height: 220px; object-fit: cover;" onerror="this.src='/images/noimage.jpg'">
                                                <span class="badge bg-success position-absolute top-0 start-0 m-2 px-3 py-2">
                                                    <i class="fa fa-check-circle me-1"></i>Approved
                                                </span>
                                                @if (car.IsAvailableForRental && car.RentalStock > 0)
                                                {
                                                    <span class="badge bg-info position-absolute top-0 end-0 m-2 px-2 py-2">
                                                        <i class="fa fa-calendar me-1"></i>For Rent
                                                    </span>
                                                }
                                            </div>
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title">@car.Name</h5>
                                                <div class="mb-2">
                                                    <span class="h5 text-success fw-bold">@car.Price.ToString("N0") TND</span>
                                                    @if (car.DailyRentalRate.HasValue)
                                                    {
                                                        <span class="text-muted ms-2">/ @car.DailyRentalRate.Value.ToString("N0") TND/day</span>
                                                    }
                                                </div>
                                                
                                                <!-- Detailed Information -->
                                                <div class="car-details mb-3">
                                                    <div class="row g-2 small">
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-calendar text-primary me-1"></i>
                                                                <strong>Year:</strong> @car.Year
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-tachometer-alt text-primary me-1"></i>
                                                                <strong>Mileage:</strong> @car.Mileage.ToString("N0") km
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-gas-pump text-primary me-1"></i>
                                                                <strong>Fuel:</strong> @car.FuelType
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="detail-item">
                                                                <i class="fa fa-cogs text-primary me-1"></i>
                                                                <strong>Trans:</strong> @car.Transmission
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Approval Information -->
                                                @if (car.ApprovedAt.HasValue)
                                                {
                                                    <div class="approval-info mb-3 p-2 bg-light rounded">
                                                        <div class="small">
                                                            <i class="fa fa-check-circle text-success me-1"></i>
                                                            <strong>Approved:</strong> @car.ApprovedAt.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")
                                                            @if (!string.IsNullOrEmpty(car.ApprovedBy))
                                                            {
                                                                <br />
                                                                <i class="fa fa-user-check text-primary me-1"></i>
                                                                <strong>By:</strong> @car.ApprovedBy
                                                            }
                                                            @if (!string.IsNullOrEmpty(car.AdminApprovalNote))
                                                            {
                                                                <br />
                                                                <i class="fa fa-sticky-note text-info me-1"></i>
                                                                <strong>Note:</strong> @car.AdminApprovalNote
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                <!-- Seller Information -->
                                                <div class="seller-info mb-3 p-2 bg-light rounded">
                                                    <div class="small">
                                                        <i class="fa fa-user me-1"></i><strong>Seller:</strong> @(car.Seller?.UserName ?? "Unknown")
                                                        <br />
                                                        <i class="fa fa-map-marker-alt me-1"></i><strong>Location:</strong> @(car.Location ?? "Not specified")
                                                    </div>
                                                </div>

                                                <!-- Action Buttons -->
                                                <div class="mt-auto">
                                                    <div class="row g-2">
                                                        <div class="col-12">
                                                            <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => ViewProduct(car.ProductId)">
                                                                <i class="fa fa-external-link-alt me-1"></i>View Listing
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-clipboard-list fa-4x text-muted mb-3"></i>
                                <h4 class="text-muted">No Approved Listings</h4>
                                <p class="text-muted">Approved listings will appear here.</p>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>
<!-- /SECTION -->

<!-- Approve Modal -->
@if (showApproveModal && selectedCar != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fa fa-check-circle me-2"></i>Approve Car Listing</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseApproveModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        <strong>Listing:</strong> @selectedCar.Name
                    </div>
                    <div class="mb-3">
                        <label for="approveNote" class="form-label">Approval Note (optional)</label>
                        <textarea class="form-control" id="approveNote" @bind="approvalNote" rows="4" 
                                  placeholder="Add any comments or notes about this approval..."></textarea>
                        <small class="text-muted">This note will be visible to the seller.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseApproveModal">Cancel</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmApprove" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fa fa-check me-1"></i>Approve Listing
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reject Modal -->
@if (showRejectModal && selectedCar != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fa fa-times-circle me-2"></i>Reject Car Listing</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRejectModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> Rejecting this listing will permanently delete it from the system.
                    </div>
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle me-2"></i>
                        <strong>Listing:</strong> @selectedCar.Name
                    </div>
                    <div class="mb-3">
                        <label for="rejectNote" class="form-label">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="rejectNote" @bind="rejectionNote" rows="4" 
                                  placeholder="Please provide a clear reason for rejection. This will help the seller understand what needs to be improved..." required></textarea>
                        <small class="text-muted">This feedback will be sent to the seller before the listing is removed.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRejectModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmReject" disabled="@(isProcessing || string.IsNullOrWhiteSpace(rejectionNote))">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fa fa-times me-1"></i>Reject Listing
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .detail-item {
        margin-bottom: 5px;
    }
    
    .car-details {
        border-top: 1px solid #eee;
        border-bottom: 1px solid #eee;
        padding-top: 10px;
        padding-bottom: 10px;
    }
    
    .stock-info, .seller-info, .approval-info {
        font-size: 0.9rem;
    }
    
    .nav-tabs .nav-link {
        color: #666;
        font-weight: 500;
    }
    
    .nav-tabs .nav-link.active {
        color: #d32f2f;
        border-bottom-color: #d32f2f;
        border-bottom-width: 3px;
    }
    
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
    }
</style>

@code {
    private List<CarListingDto> pendingListings = new();
    private List<CarListingDto> approvedListings = new();
    private bool isLoading = true;
    private string successMessage = "";
    private string errorMessage = "";
    private bool showApproveModal = false;
    private bool showRejectModal = false;
    private CarListingDto? selectedCar = null;
    private string approvalNote = "";
    private string rejectionNote = "";
    private string activeTab = "pending";
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllListings();
    }

    private async Task LoadAllListings()
    {
        isLoading = true;
        try
        {
            var pendingTask = ApprovalService.GetPendingListingsAsync();
            var approvedTask = ApprovalService.GetApprovedListingsAsync();
            
            await Task.WhenAll(pendingTask, approvedTask);
            
            pendingListings = await pendingTask ?? new List<CarListingDto>();
            approvedListings = await approvedTask ?? new List<CarListingDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading listings: {ex.Message}";
            pendingListings = new List<CarListingDto>();
            approvedListings = new List<CarListingDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "approved" && approvedListings.Count == 0)
        {
            await LoadAllListings();
        }
        StateHasChanged();
    }

    private string GetImageUrl(string? imagePath)
    {
        if (string.IsNullOrEmpty(imagePath))
        {
            return "/images/noimage.jpg";
        }
        
        if (imagePath.StartsWith("http://") || imagePath.StartsWith("https://"))
        {
            return imagePath;
        }
        
        var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5237";
        if (imagePath.StartsWith("/"))
        {
            return $"{apiBaseUrl}{imagePath}";
        }
        
        return $"{apiBaseUrl}/images/{imagePath}";
    }

    private void ShowApproveModal(CarListingDto car)
    {
        selectedCar = car;
        approvalNote = "";
        showApproveModal = true;
    }

    private void CloseApproveModal()
    {
        showApproveModal = false;
        selectedCar = null;
        approvalNote = "";
    }

    private async Task ConfirmApprove()
    {
        if (selectedCar == null) return;

        try
        {
            isProcessing = true;
            var result = await ApprovalService.ApproveListingAsync(selectedCar.ProductId, approvalNote);
            if (result.Success)
            {
                successMessage = $"Car listing '{selectedCar.Name}' has been approved successfully.";
                CloseApproveModal();
                await LoadAllListings();
            }
            else
            {
                errorMessage = $"Failed to approve listing: {result.Message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving listing: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowRejectModal(CarListingDto car)
    {
        selectedCar = car;
        rejectionNote = "";
        showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        showRejectModal = false;
        selectedCar = null;
        rejectionNote = "";
    }

    private async Task ConfirmReject()
    {
        if (selectedCar == null || string.IsNullOrWhiteSpace(rejectionNote)) return;

        try
        {
            isProcessing = true;
            var result = await ApprovalService.RejectListingAsync(selectedCar.ProductId, rejectionNote);
            if (result.Success)
            {
                successMessage = $"Car listing '{selectedCar.Name}' has been rejected and removed.";
                CloseRejectModal();
                await LoadAllListings();
            }
            else
            {
                errorMessage = $"Failed to reject listing: {result.Message}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error rejecting listing: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ViewApprovalDetails(int productId)
    {
        NavManager.NavigateTo($"/approval/details/{productId}");
    }

    private void ViewProduct(int productId)
    {
        NavManager.NavigateTo($"/product/{productId}");
    }
}
